;;; awc-research-portable.el --- Portable identities and local PDFs -*- lexical-binding: t; -*-
(require 'awc-research)
(require 'awc-bibliography)
(require 'url-parse)

(defcustom awc-research-personal-library-id nil
  "Actual numeric Zotero user ID, when known for legacy users/0 records.
This is an identity, not an API key. New API responses can supply it too."
  :type '(choice (const nil) integer) :group 'awc-research)
(defvar-local awc-research-portable--plan nil)

(defun awc-research-portable--cache-file ()
  (expand-file-name "zotero-files-local.json" awc-research-data-directory))

(defun awc-research-portable--fields (object allowed)
  (unless (hash-table-p object) (user-error "Expected a JSON object"))
  (maphash (lambda (key _) (unless (member key allowed) (user-error "Unexpected association field: %s" key))) object))

(defun awc-research-portable--key (value)
  (unless (and (stringp value) (string-match-p (concat "\\`" bibtex-reference-key "\\'") value))
    (user-error "Invalid citation key in association data"))
  value)

(defun awc-research-portable--item (value)
  (unless (and (stringp value) (string-match-p "\\`[A-Z0-9]\\{8\\}\\'" value))
    (user-error "Invalid Zotero item/attachment key"))
  value)

(defun awc-research-portable--library (library &optional item)
  "Normalize a library alias using explicit configuration or ITEM metadata."
  (awc-research--library library)
  (let* ((metadata (alist-get 'library item))
         (type (alist-get 'type metadata)) (id (alist-get 'id metadata))
         (observed (when (and (integerp id) (> id 0))
                     (cond ((equal type "user") (format "users/%d" id))
                           ((equal type "group") (format "groups/%d" id))))))
    (when (and observed (not (equal library "users/0")) (not (equal library observed)))
      (user-error "Zotero returned a different library identity"))
    (when (and (equal library "users/0") observed (not (string-prefix-p "users/" observed)))
      (user-error "Zotero returned a group for a personal-library request"))
    (if (equal library "users/0")
        (or (and observed (string-prefix-p "users/" observed) observed)
            (when (and (integerp awc-research-personal-library-id) (> awc-research-personal-library-id 0))
              (format "users/%d" awc-research-personal-library-id))
            library)
      library)))

(defun awc-research-portable--identity (row)
  (concat (gethash "library" row) "/" (gethash "item" row)))

(defun awc-research-portable--row (key link &optional portable)
  "Copy the path-free fields of LINK, validating its canonical KEY."
  (unless (hash-table-p link) (user-error "Invalid association for %s" key))
  (let ((row (make-hash-table :test 'equal)))
    (puthash "citekey" (awc-research-portable--key key) row)
    (let ((library (awc-research-portable--library (gethash "library" link))))
      (when (and portable (equal library "users/0"))
        (user-error "users/0 is device-local; supply the actual personal library ID before exporting"))
      (puthash "library" library row))
    (puthash "item" (awc-research-portable--item (gethash "item" link)) row)
    (when-let* ((native (gethash "zoteroCitationKey" link)))
      (puthash "zoteroCitationKey" (awc-research-portable--key native) row))
    (when-let* ((reference (gethash "reference" link)))
      (awc-research-portable--fields reference '("doi" "title" "year"))
      (maphash (lambda (_ value) (unless (stringp value) (user-error "Reference hints must be strings"))) reference)
      (puthash "reference" reference row))
    row))

(defun awc-research-portable--decode (text &optional portable)
  (let* ((object (condition-case nil (json-parse-string text :object-type 'hash-table)
                   (error (user-error "Invalid association JSON"))))
         (records (and (hash-table-p object) (gethash "associations" object)))
         (links (make-hash-table :test 'equal)) (identities (make-hash-table :test 'equal)))
    (awc-research-portable--fields object '("version" "associations"))
    (unless (and (eq (gethash "version" object) 1) (vectorp records))
      (user-error "Expected association format version 1 and an associations array"))
    (seq-doseq (record records)
      (awc-research-portable--fields record '("citekey" "library" "item" "zoteroCitationKey" "reference"))
      (let* ((key (gethash "citekey" record))
             (row (awc-research-portable--row key record portable))
             (identity (awc-research-portable--identity row)))
        (when (or (gethash key links) (gethash identity identities))
          (user-error "Duplicate citation key or Zotero identity in associations: %s" key))
        (puthash key row links) (puthash identity key identities)))
    links))

(defun awc-research-portable--text (file)
  (when (file-exists-p file)
    (with-temp-buffer (insert-file-contents file) (buffer-string))))

(defun awc-research-portable--read ()
  (if-let* ((text (awc-research-portable--text (awc-research--links-file))))
      (awc-research-portable--decode text)
    (make-hash-table :test 'equal)))

(defun awc-research-portable--encode (links &optional portable)
  (let ((object (make-hash-table :test 'equal)))
    (puthash "version" 1 object)
    (puthash "associations"
             (vconcat (mapcar (lambda (key) (awc-research-portable--row key (gethash key links) portable))
                             (sort (hash-table-keys links) #'string<))) object)
    (let ((json-encoding-pretty-print t)) (concat (json-encode object) "\n"))))

(defun awc-research-portable--local-path (path)
  (unless (and (stringp path) (file-name-absolute-p path) (not (file-remote-p path))
               (not (string-match-p "\0" path)))
    (user-error "PDF cache requires a local absolute path"))
  path)

(defun awc-research-portable--cache ()
  (let ((cache (make-hash-table :test 'equal)))
    (when-let* ((text (awc-research-portable--text (awc-research-portable--cache-file))))
      (let* ((object (json-parse-string text :object-type 'hash-table))
             (items (and (hash-table-p object) (gethash "items" object))))
        (awc-research-portable--fields object '("version" "items"))
        (unless (and (eq (gethash "version" object) 1) (vectorp items))
          (user-error "Invalid device PDF cache; retain it and resolve again after repair"))
        (seq-doseq (row items)
          (awc-research-portable--fields row '("library" "item" "source" "attachments"))
          (awc-research--library (gethash "library" row))
          (awc-research-portable--item (gethash "item" row))
          (unless (and (member (gethash "source" row) '("export" "resolved" "manual"))
                       (vectorp (gethash "attachments" row)))
            (user-error "Invalid local attachment cache"))
          (seq-doseq (attachment (gethash "attachments" row))
            (awc-research-portable--fields attachment '("item" "path" "title"))
            (when-let* ((key (gethash "item" attachment))) (awc-research-portable--item key))
            (when-let* ((title (gethash "title" attachment)))
              (unless (stringp title) (user-error "Invalid local attachment title")))
            (awc-research-portable--local-path (gethash "path" attachment)))
          (let ((identity (awc-research-portable--identity row)))
            (when (gethash identity cache) (user-error "Duplicate local PDF cache identity"))
            (puthash identity row cache)))))
    cache))

(defun awc-research-portable--write (file text)
  "Write derived/owned state atomically, without changing identical content."
  (unless (equal text (awc-research-portable--text file))
    (when (or (file-symlink-p file) (file-remote-p file)
              (and (file-exists-p file) (not (file-writable-p file)))
              (stringp (file-locked-p file)))
      (user-error "Association/cache target is linked, locked or not writable: %s" file))
    (awc-research--write-owned file text)))

(defun awc-research-portable--save-cache (cache)
  (let ((object (make-hash-table :test 'equal)))
    (puthash "version" 1 object)
    (puthash "items" (vconcat (mapcar (lambda (key) (gethash key cache))
                                      (sort (hash-table-keys cache) #'string<))) object)
    (let ((json-encoding-pretty-print t))
      (awc-research-portable--write (awc-research-portable--cache-file) (concat (json-encode object) "\n")))))

(defun awc-research-portable--cache-row (link attachments source)
  (let ((row (make-hash-table :test 'equal)))
    (puthash "library" (gethash "library" link) row)
    (puthash "item" (gethash "item" link) row)
    (puthash "source" source row) (puthash "attachments" (vconcat attachments) row)
    row))

(defun awc-research-portable--links ()
  "Combine canonical identities with local paths; legacy data is read-only."
  (let ((legacy (awc-research--read-legacy-links))
        (active (awc-research-portable--read))
        (cache (awc-research-portable--cache))
        (links (make-hash-table :test 'equal)) (identities (make-hash-table :test 'equal)))
    (maphash (lambda (key old) (puthash key (awc-research-portable--row key old) links)) legacy)
    (maphash (lambda (key row)
               (when-let* ((old (gethash key links)))
                 (unless (or (equal (awc-research-portable--identity row) (awc-research-portable--identity old))
                             (and (equal (gethash "item" row) (gethash "item" old))
                                  (equal (gethash "library" old) "users/0")
                                  (string-prefix-p "users/" (gethash "library" row))))
                   (user-error "Legacy and portable identities conflict for %s" key)))
               (puthash key row links)) active)
    (maphash
     (lambda (key row)
       (let* ((identity (awc-research-portable--identity row))
              (local (gethash identity cache)) (old (gethash key legacy))
              (old-library (and old (awc-research-portable--library (gethash "library" old)))))
         (when (gethash identity identities) (user-error "One Zotero item has multiple citation keys"))
         (puthash identity key identities)
         (puthash "attachments" (and local (gethash "attachments" local)) row)
         (puthash "files"
                  (if local
                      (vconcat (mapcar (lambda (a) (gethash "path" a)) (append (gethash "attachments" local) nil)))
                    (when (and old (equal old-library (gethash "library" row))
                               (equal (gethash "item" old) (gethash "item" row)))
                      (gethash "files" old))) row))) links)
    links))

(defun awc-research-portable--reference (entry)
  (let ((hint (make-hash-table :test 'equal)))
    (dolist (field '("doi" "title" "year"))
      (when-let* ((value (citar-get-value field entry))) (puthash field value hint)))
    hint))

(defun awc-research-portable--save-item (key link files entry)
  "Persist one import. Cache is derived; association commit comes last."
  (let* ((links (awc-research--read-links))
         (row (awc-research-portable--row key link))
         (cache (awc-research-portable--cache))
         (identity (awc-research-portable--identity row))
         (local (gethash identity cache)))
    (puthash "reference" (awc-research-portable--reference entry) row)
    (when (and files (or (not local) (equal (gethash "source" local) "export")))
      (puthash identity
               (awc-research-portable--cache-row
                row (mapcar (lambda (path)
                              (let ((a (make-hash-table :test 'equal)))
                                (puthash "path" (awc-research-portable--local-path path) a) a))
                            (delete-dups files)) "export") cache)
      (awc-research-portable--save-cache cache))
    (puthash key row links)
    (awc-research-portable--write (awc-research--links-file) (awc-research-portable--encode links))))

(defun awc-research-portable--inputs (&rest extra)
  (delete-dups (append (list (awc-research--links-file) (awc-research--legacy-links-file)
                             (awc-research-portable--cache-file))
                       (default-value 'citar-bibliography) extra)))

(defun awc-research-portable--catalog (snapshots)
  (awc-bibliography--catalog
   (cl-remove-if-not (lambda (s) (member (plist-get s :file) (default-value 'citar-bibliography))) snapshots)))

(defun awc-research-portable--hint-entry (row)
  (when-let* ((hint (gethash "reference" row)))
    (mapcar (lambda (field) (cons field (gethash field hint))) '("doi" "title" "year"))))

(defun awc-research-portable--merge (links incoming catalog)
  "Add identities without key migration, removal or bibliography changes."
  (maphash
   (lambda (key row)
     (if-let* ((old (gethash key links)))
         (unless (equal (awc-research-portable--identity old) (awc-research-portable--identity row))
           (user-error "Citation %s is associated with a different library/item; reconcile first" key))
       (maphash (lambda (other old)
                  (when (equal (awc-research-portable--identity old) (awc-research-portable--identity row))
                    (user-error "This Zotero item already uses citation %s; no key migration performed" other))) links)
       (when (gethash key catalog)
         (let ((entry (awc-bibliography--one key catalog)) (hint (awc-research-portable--hint-entry row)))
           (unless (and hint (awc-research--same-reference-p (plist-get entry :values) hint))
             (user-error "Existing bibliography key %s conflicts with the transfer's reference hint" key))))
       (puthash key row links))) incoming)
  links)

(defun awc-research-portable--target (file &optional internal)
  (unless (and (not (file-remote-p file)) (not (file-symlink-p file))
               (equal (downcase (or (file-name-extension file) "")) "json")
               (not (file-directory-p file))
               (not (stringp (file-locked-p file)))
               (or (not (file-exists-p file)) (file-writable-p file)))
    (user-error "Choose a writable, unlocked local JSON file without a symlink"))
  (unless internal
    (when (member (file-truename file)
                  (mapcar #'file-truename (awc-research-portable--inputs)))
      (user-error "Export to a separate transfer file; keep owned state and bibliographies intact"))
    (unless (file-writable-p (file-name-directory file))
      (user-error "Create a writable export directory first"))))

(defun awc-research-portable--prepare (kind file &optional keys)
  "Prepare an export or additive import, capturing every input before review."
  (require 'citar)
  (setq file (expand-file-name file))
  (let* ((target (if (eq kind 'import) (awc-research--links-file) file))
         (snapshots (mapcar #'awc-bibliography--snapshot
                            (awc-research-portable--inputs file target)))
         (catalog (awc-research-portable--catalog snapshots))
         (links (awc-research--read-links)) candidate)
    (awc-research-portable--target target (eq kind 'import))
    (if (eq kind 'import)
        (setq candidate (awc-research-portable--encode
                         (awc-research-portable--merge links
                          (awc-research-portable--decode
                           (or (awc-research-portable--text file) (user-error "Transfer file is missing")) t) catalog)))
      (when-let* ((text (awc-research-portable--text target)))
        (awc-research-portable--decode text t))
      (let ((selected (make-hash-table :test 'equal))
            (awc-research-personal-library-id awc-research-personal-library-id))
        (dolist (key (or keys (sort (hash-table-keys links) #'string<)))
          (let ((link (or (gethash key links) (user-error "No explicit association for %s" key))))
            (when (and (equal (gethash "library" link) "users/0") (not awc-research-personal-library-id))
              (let* ((item (awc-research--get (format "users/0/items/%s" (gethash "item" link))))
                     (library (awc-research-portable--library "users/0" item)))
                (unless (and (equal (alist-get 'key item) (gethash "item" link))
                             (not (equal library "users/0")))
                  (user-error "Set awc-research-personal-library-id to the actual user ID before exporting legacy aliases"))
                (setq awc-research-personal-library-id (string-to-number (substring library 6)))))
            (let ((row (awc-research-portable--row key link t)))
              (when (gethash key catalog)
                (puthash "reference" (awc-research-portable--reference
                                      (plist-get (awc-bibliography--one key catalog) :values)) row))
              (puthash key row selected))))
        (setq candidate (awc-research-portable--encode selected t))
        ;; Validate identity uniqueness after users/0 normalization too.
        (awc-research-portable--decode candidate t)))
    (awc-bibliography--check snapshots)
    (list :target target :new candidate :old (or (awc-research-portable--text target) "")
          :snapshots snapshots :kind kind)))

(defvar awc-research-portable-review-mode-map
  (let ((map (make-sparse-keymap)))
    (set-keymap-parent map diff-mode-map)
    (define-key map (kbd "C-c C-c") #'awc-research-portable-apply)
    (define-key map (kbd "q") #'quit-window) map))
(define-derived-mode awc-research-portable-review-mode diff-mode "Identity review"
  "Review identities; C-c C-c applies, q leaves them unapplied."
  (setq buffer-read-only t))

(defun awc-research-portable--review (plan)
  (if (equal (plist-get plan :old) (plist-get plan :new))
      (progn (message "Association transfer is already current") nil)
    (let ((before (make-temp-file "awc-identities-before-"))
          (after (make-temp-file "awc-identities-after-"))
          (buffer (generate-new-buffer "*Reference identity review*")) success)
      (unwind-protect
          (progn
            (let ((coding-system-for-write 'utf-8-unix))
              (write-region (plist-get plan :old) nil before nil 'silent)
              (write-region (plist-get plan :new) nil after nil 'silent))
            (unless (memq (call-process "diff" nil buffer nil "-u" "--label" "before" "--label" "reviewed identities" before after) '(0 1))
              (user-error "Cannot prepare identity diff"))
            (with-current-buffer buffer
              (goto-char (point-min))
              (insert (format "Reference associations: %s\nTarget: %s\n\nC-c C-c: apply this diff.  q: leave unapplied.\nCitation keys remain unchanged. PDFs, bibliographies and notes are not transferred.\n\n"
                              (plist-get plan :kind) (plist-get plan :target)))
              (awc-research-portable-review-mode)
              (setq-local awc-research-portable--plan plan)
              (set-buffer-modified-p nil) (goto-char (point-min)))
            (pop-to-buffer buffer) (setq success t) buffer)
        (delete-file before) (delete-file after)
        (unless success (kill-buffer buffer))))))

;;;###autoload
(defun awc-research-export-associations (file &optional keys)
  "Review exporting path-free associations to FILE, optionally only KEYS."
  (interactive (list (read-file-name "Export associations to: " nil nil nil "associations.json")))
  (awc-research-portable--review (awc-research-portable--prepare 'export file keys)))

;;;###autoload
(defun awc-research-import-associations (file)
  "Review merging the portable associations in FILE into this device."
  (interactive (list (read-file-name "Import associations from: " nil nil t)))
  (awc-research-portable--review (awc-research-portable--prepare 'import file)))

(defun awc-research-portable-apply ()
  "Apply the fixed identity review after rechecking its captured inputs."
  (interactive)
  (unless awc-research-portable--plan (user-error "No unapplied identity review here"))
  (let* ((plan awc-research-portable--plan) (target (plist-get plan :target)))
    (awc-research-portable--target target (eq (plist-get plan :kind) 'import))
    (awc-bibliography--check (plist-get plan :snapshots))
    (unwind-protect
        (progn
          (when (eq (plist-get plan :kind) 'import)
            (awc-files-private-directory awc-research-data-directory))
          (lock-file target)
          (awc-bibliography--check (plist-get plan :snapshots))
          (awc-research-portable--write target (plist-get plan :new))
          (setq awc-research-portable--plan nil)
          (when-let* ((buffer (find-buffer-visiting target)))
            (with-current-buffer buffer (revert-buffer t t)))
          (message "Applied reference identity %s: %s" (plist-get plan :kind) target)
          target)
      (unlock-file target))))

(defun awc-research-portable--pdf-file-p (file)
  (and (stringp file) (not (file-remote-p file)) (file-regular-p file) (file-readable-p file)
       (with-temp-buffer
         (insert-file-contents-literally file nil 0 1024)
         (goto-char (point-min)) (looking-at "%PDF-"))))

(defun awc-research-portable--url-path (url)
  "Decode only local file URLs, preserving percent-encoded #/? and Unicode."
  (let* ((parsed (url-generic-parse-url (string-trim url)))
         (path (url-filename parsed)))
    (unless (and (equal (url-type parsed) "file") (member (url-host parsed) '(nil "" "localhost"))
                 (not (url-target parsed)) (not (string-match-p "[?#]" path)))
      (user-error "Zotero returned a non-local attachment URL"))
    (awc-research-portable--local-path (decode-coding-string (url-unhex-string path) 'utf-8))))

;;;###autoload
(defun awc-research-resolve-pdfs (key)
  "Read Zotero attachment identities and refresh only this device's PDF cache."
  (interactive (list (awc-research--global-key)))
  (let* ((snapshots (mapcar #'awc-bibliography--snapshot (awc-research-portable--inputs)))
         (link (or (gethash key (awc-research--read-links)) (user-error "Associate %s first" key)))
         (library (gethash "library" link)) (parent (gethash "item" link))
         (item (awc-research--get (format "%s/items/%s" library parent)))
         (children (awc-research--get (format "%s/items/%s/children" library parent)))
         (seen (make-hash-table :test 'equal)) attachments)
    (unless (equal (alist-get 'key item) parent) (user-error "Zotero parent identity mismatch"))
    (awc-research-portable--library library item)
    (unless (listp children) (user-error "Invalid Zotero attachment list"))
    (dolist (child children)
      (let* ((data (alist-get 'data child)) (attachment (alist-get 'key child)))
        (when (and (equal (alist-get 'itemType data) "attachment")
                   (not (memq (alist-get 'deleted data) '(1 t)))
                   (or (equal (alist-get 'contentType data) "application/pdf")
                       (string-suffix-p ".pdf" (downcase (or (alist-get 'filename data) "")))))
          (awc-research-portable--item attachment)
          (awc-research-portable--library library child)
          (unless (equal (alist-get 'parentItem data) parent) (user-error "PDF attachment belongs to another parent"))
          (when (gethash attachment seen) (user-error "Duplicate Zotero attachment identity"))
          (puthash attachment t seen)
          (condition-case err
              (let ((path (awc-research-portable--url-path
                           (awc-research--get (format "%s/items/%s/file/view/url" library attachment) t))))
                (when (awc-research-portable--pdf-file-p path)
                  (let ((row (make-hash-table :test 'equal)))
                    (puthash "item" attachment row) (puthash "path" path row)
                    (puthash "title" (or (alist-get 'title data) attachment) row)
                    (push row attachments))))
            (awc-research-http-error (unless (eq (nth 2 err) 404) (signal (car err) (cdr err))))))))
    (awc-bibliography--check snapshots)
    (setq attachments (nreverse attachments))
    (let ((cache (awc-research-portable--cache)))
      (puthash (awc-research-portable--identity link)
               (awc-research-portable--cache-row link attachments "resolved") cache)
      (awc-research-portable--save-cache cache))
    (unless attachments
      (user-error "No local PDF is available; cache cleared. Check Zotero file sync, or link a file with C-c w n P"))
    (message "Resolved %d device-local PDF(s) for %s" (length attachments) key)
    (mapcar (lambda (a) (gethash "path" a)) attachments)))

;;;###autoload
(defun awc-research-link-local-pdf (key file)
  "Explicitly associate an existing local PDF FILE with reference KEY."
  (interactive (list (awc-research--global-key) (read-file-name "Local PDF: " nil nil t)))
  (setq file (expand-file-name file))
  (unless (awc-research-portable--pdf-file-p file) (user-error "Choose a readable local PDF file"))
  (let* ((snapshots (mapcar #'awc-bibliography--snapshot (awc-research-portable--inputs)))
         (link (or (gethash key (awc-research--read-links)) (user-error "Associate %s first" key)))
         (cache (awc-research-portable--cache))
         (identity (awc-research-portable--identity link))
         (previous (gethash identity cache))
         (attachments (cl-remove-if (lambda (a) (equal file (gethash "path" a)))
                                    (append (and previous (gethash "attachments" previous)) nil)))
         (row (or (cl-find file (append (and previous (gethash "attachments" previous)) nil)
                           :key (lambda (a) (gethash "path" a)) :test #'equal)
                  (make-hash-table :test 'equal))))
    (puthash "path" file row)
    (puthash identity (awc-research-portable--cache-row link (append attachments (list row)) "manual") cache)
    (awc-bibliography--check snapshots)
    (awc-research-portable--save-cache cache)
    (message "Linked device-local PDF for %s" key)))

(defun awc-research-portable--pdf-links (link)
  (let ((library (gethash "library" link)) links)
    (seq-doseq (attachment (gethash "attachments" link))
      (when-let* ((item (gethash "item" attachment)))
        (push (format "[Open PDF in Zotero (%s)](zotero://open-pdf/%s/items/%s)\n\n"
                      item (if (string-prefix-p "users/" library) "library" library) item) links)))
    (apply #'concat (nreverse links))))

(provide 'awc-research-portable)
