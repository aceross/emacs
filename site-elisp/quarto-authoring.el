;;; quarto-authoring.el --- Source authoring and chunk commands -*- lexical-binding: t; -*-
(require 'quarto-context)
(require 'xref)
(require 'imenu)
(require 'bibtex)
(defvar citar-bibliography)
(declare-function citar-insert-citation "citar" ())
(declare-function consult-imenu "consult-imenu" ())
(declare-function yas-expand-snippet "yasnippet" (snippet &optional start end expand-env))
(defvar-local quarto-authoring--folds nil)
(defvar-local quarto-authoring--bibliographies nil)
(defvar-local quarto-authoring--citations nil)

(defun quarto-goto-source-position (position)
  "Visit POSITION, crossing polymode boundaries when necessary."
  (widen)
  (goto-char position)
  (when (and (bound-and-true-p polymode-mode)
             (eq (window-buffer (selected-window)) (current-buffer)))
    (pm-switch-to-buffer position)
    (goto-char position)))

(defun quarto-insert-chunk (language label)
  "Insert an executable chunk for LANGUAGE with optional LABEL."
  (interactive (list (completing-read "Language: " '("r" "python") nil t)
                     (read-string "Label (optional): ")))
  (unless (bolp) (insert "\n"))
  (insert (format "```{%s}\n" language))
  (unless (string-empty-p label) (insert "#| label: " label "\n"))
  (save-excursion (insert "\n```\n")))

(defun quarto-next-chunk (&optional backwards)
  (interactive)
  (let* ((chunks (quarto-document-chunks (quarto-document-model)))
         (pos (point))
         (chunk (cl-find-if (lambda (c) (if backwards (< (quarto-chunk-start c) pos)
                                         (> (quarto-chunk-start c) pos)))
                            (if backwards (reverse chunks) chunks))))
    (unless chunk (user-error "No %s chunk" (if backwards "previous" "next")))
    (quarto-goto-source-position (quarto-chunk-start chunk))))
(defun quarto-previous-chunk () (interactive) (quarto-next-chunk t))
(defun quarto-select-chunk ()
  (interactive)
  (let ((chunk (or (quarto-chunk-at) (user-error "No chunk here"))))
    (quarto-goto-source-position (quarto-chunk-head-end chunk))
    (push-mark (quarto-chunk-body-end chunk) t t)))
(defun quarto-fold-chunk ()
  (interactive)
  (let* ((chunk (or (quarto-chunk-at) (user-error "No chunk here")))
         (source (quarto-source-buffer))
         (folds (cl-remove-if-not #'overlay-buffer
                                 (buffer-local-value 'quarto-authoring--folds source)))
         (existing (cl-find-if (lambda (o) (= (overlay-start o) (quarto-chunk-head-end chunk))) folds)))
    (with-current-buffer source (setq quarto-authoring--folds folds))
    (if existing (progn (delete-overlay existing)
                        (with-current-buffer source
                          (setq quarto-authoring--folds (delq existing folds))))
      (let ((overlay (make-overlay (quarto-chunk-head-end chunk) (quarto-chunk-body-end chunk))))
        (overlay-put overlay 'invisible t)
        (overlay-put overlay 'isearch-open-invisible #'delete-overlay)
        (overlay-put overlay 'after-string (propertize (format " … %s %s\n" (quarto-chunk-language chunk)
                                                              (or (quarto-chunk-label chunk) "")) 'face 'shadow))
        (with-current-buffer source (push overlay quarto-authoring--folds))))))

(defun quarto-imenu-index ()
  (let* ((model (quarto-document-model))
         (headings (mapcar (lambda (h) (cons (concat (make-string (nth 2 h) ?#) " " (car h)) (cadr h)))
                          (quarto-document-headings model)))
         (chunks (mapcar (lambda (c) (cons (format "[%s] %s" (or (quarto-chunk-language c) "example")
                                                  (or (quarto-chunk-label c) (format "Chunk %d" (quarto-chunk-id c))))
                                           (quarto-chunk-start c))) (quarto-document-chunks model))))
    (sort (append headings chunks) (lambda (a b) (< (cdr a) (cdr b))))))
(defun quarto-outline ()
  (interactive)
  (require 'consult)
  (widen)
  (consult-imenu))

(defun quarto-authoring-bibliographies (context)
  "Use CONTEXT's bibliographies without changing personal Citar settings."
  (let* ((metadata (plist-get context :metadata)) (values (quarto-get metadata "bibliography"))
         (dir (file-name-directory (plist-get context :file)))
         (root (plist-get context :project-directory)) keys)
    (setq quarto-authoring--bibliographies
          (mapcar (lambda (file) (let ((path (expand-file-name file dir)))
                                  (if (file-readable-p path) path (expand-file-name file root))))
                  (if (stringp values) (list values) values))
          quarto-authoring--citations nil)
    (setq-local citar-bibliography quarto-authoring--bibliographies)
    (dolist (file quarto-authoring--bibliographies)
      (when (file-readable-p file)
        (with-temp-buffer
          (insert-file-contents file)
          (goto-char (point-min))
          (while (re-search-forward "^[ \t]*@[[:alpha:]]+[ \t\n]*[{(][ \t\n]*\\([^, \t\n]+\\)," nil t)
            (push (match-string-no-properties 1) keys)))))
    (setq quarto-authoring--citations (delete-dups (nreverse keys)))))

(defun quarto-authoring-refresh-bibliographies ()
  (interactive)
  (let ((source (quarto-source-buffer)))
    (quarto-context-resolve
     (lambda (context error)
       (if error (message "Quarto bibliography: %s" error)
         (with-current-buffer source (quarto-authoring-bibliographies context)))))))

(defun quarto-insert-citation ()
  (interactive)
  (require 'citar)
  (let ((citar-bibliography (buffer-local-value 'quarto-authoring--bibliographies (quarto-source-buffer))))
    (unless citar-bibliography (user-error "No document bibliography; refresh it from C-c q"))
    (citar-insert-citation)))

(defun quarto-reference-completion-at-point ()
  (unless (quarto-chunk-at)
    (let ((end (point)) (start (save-excursion (skip-chars-backward "[:alnum:]_:.+-") (point))))
      (when (eq (char-before start) ?@)
        (list start end
              (append (mapcar #'car (quarto-document-labels (quarto-document-model)))
                      (buffer-local-value 'quarto-authoring--citations (quarto-source-buffer)))
              :exclusive 'no)))))

(cl-defmethod xref-backend-identifier-at-point ((_backend (eql quarto)))
  (if (quarto-chunk-at) (thing-at-point 'symbol t)
    (save-excursion
      (skip-chars-backward "[:alnum:]_:.+-")
      (let ((start (point))) (skip-chars-forward "[:alnum:]_:.+-")
        (unless (= start (point)) (buffer-substring-no-properties start (point)))))))
(cl-defmethod xref-backend-definitions ((_backend (eql quarto)) identifier)
  (if (and (quarto-chunk-at) (fboundp 'quarto-lsp-xrefs))
      (quarto-lsp-xrefs "textDocument/definition")
    (let ((label (assoc identifier (quarto-document-labels (quarto-document-model)))))
      (when label (list (xref-make identifier (xref-make-buffer-location (quarto-source-buffer) (cdr label))))))))
(cl-defmethod xref-backend-references ((_backend (eql quarto)) identifier)
  (if (and (quarto-chunk-at) (fboundp 'quarto-lsp-xrefs))
      (quarto-lsp-xrefs "textDocument/references")
    (mapcar (lambda (ref) (xref-make identifier (xref-make-buffer-location (quarto-source-buffer) (cdr ref))))
            (cl-remove-if-not (lambda (ref) (equal identifier (car ref)))
                              (quarto-document-references (quarto-document-model))))))

(defun quarto-prose-spelling-p ()
  "Keep spell checking outside front matter, chunks and inline code."
  (and (not (quarto-chunk-at)) (not (quarto-yaml-position-p))
       (not (and (fboundp 'markdown-inline-code-at-pos) (markdown-inline-code-at-pos (point))))))

(defun quarto-insert-template (template)
  (interactive (list (completing-read "Insert: " '("figure" "table" "callout" "equation") nil t)))
  (require 'yasnippet)
  (yas-expand-snippet
   (pcase template
     ("figure" "![${1:Caption}](${2:figure.png}){#fig-${3:label}}\n$0")
     ("table" "| ${1:Column} | ${2:Column} |\n|---|---|\n| $0 | |\n\n: ${3:Caption} {#tbl-${4:label}}\n")
     ("callout" "::: {.callout-${1:note}}\n## ${2:Title}\n\n$0\n:::\n")
     ("equation" "$$\n$0\n$$ {#eq-${1:label}}\n"))))

(provide 'quarto-authoring)
