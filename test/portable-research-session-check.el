;;; portable-research-session-check.el --- Independent device fixture -*- lexical-binding: t; -*-
(load (expand-file-name "quarto-test-setup.el" (file-name-directory load-file-name)) nil t)
(require 'awc-research-portable)
(require 'citar)
(require 'ert)
(setq quarto-lsp-auto-start nil)
(defvar awc-portable-root (getenv "AWC_PORTABLE_DEVICE"))
(unless (and awc-portable-root (file-in-directory-p awc-portable-root "/tmp/"))
  (error "Portable fixtures must be under /tmp"))
(setq user-emacs-directory (expand-file-name "config/" awc-portable-root)
      awc-research-data-directory (expand-file-name "data/" awc-portable-root)
      awc-research-vault-directory (expand-file-name "vault/" awc-portable-root)
      awc-research-legacy-notes-directories nil
      awc-research-zotero-api-url (or (getenv "AWC_PORTABLE_API") "http://127.0.0.1:1/api/")
      citar-bibliography (list (expand-file-name "existing.bib" awc-portable-root))
      citar--entries nil create-lockfiles nil auto-save-default nil)
(awc-research-setup)
(defun awc-portable-read (file)
  (with-temp-buffer (insert-file-contents file) (buffer-string)))
(defun awc-portable-apply (buffer)
  (should (buffer-live-p buffer))
  (save-window-excursion
    (switch-to-buffer buffer)
    (execute-kbd-macro (kbd "C-c C-c")))
  (kill-buffer buffer))
(let* ((stage (getenv "AWC_PORTABLE_STAGE"))
       (packet (expand-file-name "transfer.json" (file-name-directory (directory-file-name awc-portable-root))))
       (primary (car citar-bibliography))
       (primary-before (awc-portable-read primary)))
  (pcase stage
    ("send"
     (should (equal "legacy:key" (awc-research-import-item "ABC12345")))
     (should (equal "users/12345" (gethash "library" (gethash "legacy:key" (awc-research--read-links)))))
     (should (= 2 (length (awc-research-resolve-pdfs "legacy:key"))))
     (let* ((note (awc-research-open-note "legacy:key")) (file (buffer-file-name note))
            (renamed (expand-file-name "My renamed reading note.md" awc-research-vault-directory)))
       (with-current-buffer note
         (should (string-match-p "zotero://open-pdf/library/items/PDF12345" (buffer-string)))
         (should-not (string-match-p "file://" (buffer-string))))
       (kill-buffer note) (rename-file file renamed))
     (awc-portable-apply (awc-research-export-associations packet))
     (let* ((project (expand-file-name "manuscript/" awc-portable-root))
            (paper (expand-file-name "paper.qmd" project)))
       (make-directory project)
       (with-temp-file (expand-file-name "_quarto.yml" project)
         (insert "project:\n  type: default\nbibliography: references.bib\n"))
       (with-temp-file (expand-file-name "references.bib" project) (insert "% Reviewed snapshot.\n"))
       (with-temp-file paper (insert "---\ntitle: Portable reference\nengine: markdown\n---\n\nEvidence [@legacy:key].\n"))
       (with-current-buffer (find-file-noselect paper)
         (awc-portable-apply (awc-bibliography-prepare "legacy:key")))))
    ("receive"
     (awc-portable-apply (awc-research-import-associations packet))
     (should-not (file-exists-p (awc-research-portable--cache-file)))
     ;; A's file is still reachable on this host: copying its BibTeX path
     ;; must not authorize it on device B.
     (should-error (awc-research-open-pdf "legacy:key") :type 'user-error)
     (let* ((file (expand-file-name "My renamed reading note.md" awc-research-vault-directory))
            (before (awc-portable-read file)))
       (should (equal file (buffer-file-name (awc-research-open-note "legacy:key"))))
       (should (equal before (awc-portable-read file)))))
    ("resolve"
     (let* ((file (expand-file-name "My renamed reading note.md" awc-research-vault-directory))
            (note-before (awc-portable-read file)))
       ;; Fixture native citationKey changed since device A. Canonical key wins.
       (should (equal "legacy:key" (awc-research-import-item "ABC12345" "users/12345")))
       (should (= 2 (length (awc-research-resolve-pdfs "legacy:key"))))
       (should (equal file (buffer-file-name (awc-research-open-note "legacy:key"))))
       (should (equal note-before (awc-portable-read file)))
       (should (= 1 (length (directory-files-recursively awc-research-vault-directory "\\.md\\'"))))
       (should-not (file-exists-p (awc-research--bibliography)))))
    ("offline"
     (let (opened)
       (cl-letf (((symbol-function 'completing-read)
                  (lambda (_ choices &rest _) (should (= 2 (length choices))) (car choices)))
                 ((symbol-function 'citar-file-open) (lambda (file) (setq opened file))))
         (awc-research-open-pdf "legacy:key"))
       (should (file-in-directory-p opened awc-portable-root))))
    (_ (error "Unknown fixture stage %s" stage)))
  (should (equal primary-before (awc-portable-read primary)))
  (should-not (file-exists-p (awc-research--legacy-links-file)))
  (princ (format "PASS portable profile %s: %s\n" stage awc-portable-root)))
;;; portable-research-session-check.el ends here
