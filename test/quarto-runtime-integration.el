;;; quarto-runtime-integration.el --- Real document execution checks -*- lexical-binding: t; -*-
;; Uses only /tmp/quarto-runtime-check. Install test dependencies explicitly first.
(load (expand-file-name "quarto-test-setup.el" (file-name-directory load-file-name)) nil t)
(require 'quarto-runtime)
(setq quarto-lsp-auto-start nil)
(defvar quarto-runtime-test-root (file-name-as-directory (or (getenv "QUARTO_TEST_RUNTIME_ROOT") "/tmp/quarto-runtime-check/project with spaces/")))
(defvar quarto-runtime-test-buffers nil)
(defun quarto-runtime-test-document (name text)
  (let ((file (expand-file-name (concat "reports/nested space/" name ".qmd") quarto-runtime-test-root)))
    (make-directory (file-name-directory file) t)
    (with-temp-file file (insert text))
    (let ((buffer (find-file-noselect file))) (push buffer quarto-runtime-test-buffers) buffer)))
(defun quarto-runtime-test-wait ()
  (quarto-test-wait (lambda () (and (not quarto-runtime--current) (not quarto-runtime--queue)
                                    (memq quarto-runtime--state '(ready failed)))) "execution" 60)
  (when (eq quarto-runtime--state 'failed)
    (error "Runtime failed: %S" quarto-runtime--results)))
(defun quarto-runtime-test-text (&optional request)
  (mapconcat (lambda (event) (quarto-get event "text" ""))
             (quarto-request-events (or request (car (last quarto-runtime--results)))) "\n"))
(defun quarto-runtime-test-run (code language)
  (goto-char (point-max))
  (insert (format "\n```{%s}\n%s\n```\n" language code))
  (forward-line -2)
  (quarto-run-chunk)
  (quarto-runtime-test-wait)
  (car (last quarto-runtime--results)))
(defun quarto-runtime-test-events (kind request)
  (cl-remove-if-not (lambda (event) (equal kind (quarto-get event "type"))) (quarto-request-events request)))

(make-directory quarto-runtime-test-root t)
(with-temp-file (expand-file-name "fixture.Rproj" quarto-runtime-test-root) (insert "Version: 1.0\n"))
(with-temp-file (expand-file-name ".Rprofile" quarto-runtime-test-root)
  (insert "options(quarto.test.startup = getwd())\n"))
(with-temp-file (expand-file-name "_quarto.yml" quarto-runtime-test-root)
  (insert "project:\n  type: default\nformat:\n  html: default\n  pdf: default\n"))
(unwind-protect
    (let* ((first (quarto-runtime-test-document "first" "---\ntitle: First\nengine: knitr\nformat: html\n---\n```{r}\nx <- 41\ncat('START:', getOption('quarto.test.startup'), '\\nCWD:', getwd())\n```\n"))
           (second (quarto-runtime-test-document "second" "---\ntitle: Second\nengine: knitr\n---\n```{r}\ncat(exists('x', envir=.GlobalEnv, inherits=FALSE))\n```\n")))
      (with-current-buffer first
        (quarto-run-all) (quarto-runtime-test-wait)
        (should (string-match-p (regexp-quote (concat "START: " (directory-file-name quarto-runtime-test-root))) (quarto-runtime-test-text)))
        (should (string-match-p (regexp-quote (concat "CWD: " quarto-runtime-test-root "reports/nested space")) (quarto-runtime-test-text)))
        (should (eq (quarto-request-state (quarto-runtime-test-run "y = r.x + 1\nprint(y)" "python")) 'succeeded))
        (should (string-match-p "42" (quarto-runtime-test-text)))
        (let ((request (quarto-runtime-test-run "import matplotlib.pyplot as plt\nplt.plot([1, 2, 3])\nplt.show()" "python")))
          (should (quarto-runtime-test-events "plot" request)))
        (quarto-runtime-test-run "import pandas as pd\npydf = pd.DataFrame({'number': range(250)})" "python")
        (quarto-inspect-table "pydf" "python" 100) (quarto-runtime-test-wait)
        (should (quarto-runtime-test-events "table" (car (last quarto-runtime--results))))
        (quarto-runtime-test-run "cat(reticulate::py$y)" "r")
        (should (string-match-p "42" (quarto-runtime-test-text)))
        (let ((request (quarto-runtime-test-run "plot(1:3)\nplot(3:1)\nwarning('test warning')" "r")))
          (should (= 2 (length (quarto-runtime-test-events "plot" request))))
          (should (quarto-runtime-test-events "warning" request)))
        (quarto-runtime-test-run "df <- data.frame(number=1:250, text=letters[(1:250 %% 26)+1])" "r")
        (quarto-inspect-table "df" "r" 100) (quarto-runtime-test-wait)
        (let* ((request (car (last quarto-runtime--results))) (event (car (quarto-runtime-test-events "table" request))))
          (should (= 250 (quarto-get event "total"))) (should (= 100 (length (quarto-get event "rows"))))
          (should (equal "101" (caar (quarto-get event "rows")))))
        (let ((request (quarto-runtime-test-run "cat(paste(rep('z', 100000), collapse=''))" "r")))
          (should (< (length (quarto-runtime-test-text request)) 25000))
          (should (> (file-attribute-size (file-attributes (quarto-runtime--log))) 100000)))
        (let ((request (quarto-runtime-test-run "stop('deliberate failure')" "r")))
          (should (eq (quarto-request-state request) 'failed)))
        (goto-char (point-max)) (insert "\n```{r}\nSys.sleep(20)\n```\n") (forward-line -2)
        (quarto-run-chunk)
        (quarto-test-wait (lambda () (and quarto-runtime--current (eq (quarto-request-state quarto-runtime--current) 'running))) "long request start")
        (quarto-interrupt) (quarto-runtime-test-wait)
        (should (eq (quarto-request-state (car (last quarto-runtime--results))) 'interrupted)))
      (with-current-buffer second
        (quarto-run-all) (quarto-runtime-test-wait)
        (should (string-match-p "FALSE" (quarto-runtime-test-text)))
        (should-not (eq quarto-runtime--process (buffer-local-value 'quarto-runtime--process first)))
        (quarto-restart))
      (with-current-buffer first
        (quarto-runtime-test-run "cat(x)" "r") (should (string-match-p "41" (quarto-runtime-test-text)))
        (goto-char 1) (search-forward "x <- 41") (insert " + 1")
        (should (eq (quarto-request-state (car (last quarto-runtime--results))) 'stale)))
      (princ "PASS knitr: mixed state, independent documents/restart, cwd, plots, warning/error, interruption, bounded output, table pages, stale results\n")
      (let ((jupyter (quarto-runtime-test-document "jupyter" "---\ntitle: Jupyter\njupyter: quarto-fixture\n---\n```{python}\nvalue = 21\nprint(value * 2)\n```\n")))
        (with-current-buffer jupyter
          (quarto-run-all) (quarto-runtime-test-wait)
          (should (equal "quarto-fixture" (quarto-get quarto-runtime--identity "kernel")))
          (should (string-match-p "42" (quarto-runtime-test-text)))
          (should (string-suffix-p "/.venv/bin/python" (quarto-get quarto-runtime--identity "interpreter")))
          (quarto-runtime-test-run "import pandas as pd\ndf = pd.DataFrame({'number': range(250)})" "python")
          (quarto-inspect-table "df" "python" 100) (quarto-runtime-test-wait)
          (let ((event (car (quarto-runtime-test-events "table" (car (last quarto-runtime--results))))))
            (should (= 250 (quarto-get event "total"))) (should (= 100 (length (quarto-get event "rows")))))
          (let ((request (quarto-runtime-test-run "%matplotlib inline\nimport matplotlib.pyplot as plt\nplt.plot([1, 2, 3]); plt.show()" "python")))
            (should (quarto-runtime-test-events "plot" request)))
          (goto-char (point-max)) (insert "\n```{python}\nimport time\ntime.sleep(20)\n```\n") (forward-line -2)
          (quarto-run-chunk)
          (quarto-test-wait (lambda () (and quarto-runtime--current (eq (quarto-request-state quarto-runtime--current) 'running))) "Jupyter long request")
          (quarto-interrupt) (quarto-runtime-test-wait)
          (princ "PASS Jupyter: intended named kernel/interpreter, state, plots, interruption and table paging\n"))))
  (dolist (buffer quarto-runtime-test-buffers)
    (when (buffer-live-p buffer)
      (with-current-buffer buffer
        (when quarto-runtime--directory (princ (format "LOG %s: %s\n" (buffer-name) quarto-runtime--directory)))
        (quarto-runtime-stop) (set-buffer-modified-p nil))
      (kill-buffer buffer))))
