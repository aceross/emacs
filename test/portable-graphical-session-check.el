;;; portable-graphical-session-check.el --- Private PDF/menu acceptance -*- lexical-binding: t; -*-
(require 'awc-research-portable)
(require 'citar)
(require 'ert)
(defun awc-portable-gui-finish ()
  (condition-case err
      (let* ((device (getenv "AWC_PORTABLE_DEVICE"))
             (awc-research-data-directory (expand-file-name "data/" device))
             (awc-research-vault-directory (expand-file-name "vault/" device))
             (awc-research-legacy-notes-directories nil)
             (citar-bibliography (list (expand-file-name "existing.bib" device)))
             (citar--entries nil)
             (note (expand-file-name "My renamed reading note.md" awc-research-vault-directory))
             (export (expand-file-name "gui-export.json" awc-reliability-root)))
        (unless (and device (file-in-directory-p device "/tmp/")) (error "Missing private device"))
        (switch-to-buffer (find-file-noselect note))
        (execute-kbd-macro (kbd "C-c w n"))
        (dolist (binding '(("E" . awc-research-export-associations) ("I" . awc-research-import-associations)
                           ("f" . awc-research-resolve-pdfs) ("P" . awc-research-link-local-pdf)))
          (should (eq (key-binding (kbd (car binding))) (cdr binding))))
        (execute-kbd-macro (kbd "C-q"))
        (let ((review (awc-research-export-associations export)))
          (redisplay t)
          (let ((coding-system-for-write 'no-conversion))
            (write-region (x-export-frames nil 'png) nil (expand-file-name "identity-review.png" awc-reliability-root) nil 'silent))
          (execute-kbd-macro (kbd "C-c C-c"))
          (should-not awc-research-portable--plan)
          (kill-buffer review))
        ;; Both fixture APIs have stopped; actual Citar dispatch opens B's PDF.
        (cl-letf (((symbol-function 'awc-research--get) (lambda (&rest _) (error "PDF open must stay offline")))
                  ((symbol-function 'completing-read)
                   (lambda (_ choices &rest _)
                     (or (cl-find-if (lambda (path) (string-match-p "Paper" path)) choices) (error "Missing main PDF")))))
          (awc-research-open-pdf "legacy:key"))
        (should (derived-mode-p 'pdf-view-mode))
        (should (file-in-directory-p buffer-file-name device))
        (should (= 1 (pdf-info-number-of-pages)))
        (should (string-match-p "Device 2" (pdf-info-gettext 1 '(0 0 1 1))))
        (let ((coding-system-for-write 'no-conversion))
          (write-region (pdf-cache-renderpage 1 900) nil (expand-file-name "pdf-page.png" awc-reliability-root) nil 'silent)
          (redisplay t)
          (write-region (x-export-frames nil 'png) nil (expand-file-name "pdf-view.png" awc-reliability-root) nil 'silent))
        (with-temp-file (expand-file-name "gui-result.txt" awc-reliability-root)
          (insert (format "PASS: %s %S; real menu, identity diff/keyboard apply, offline Citar/PDF Tools renders device B PDF\n" emacs-version window-system)))
        (awc-reliability-finish))
    (error
     (with-temp-file (expand-file-name "gui-result.txt" awc-reliability-root) (insert (format "FAIL: %S\n" err)))
     (kill-emacs 1))))
(add-hook 'emacs-startup-hook (lambda () (run-at-time 4 nil #'awc-portable-gui-finish)) t)
;;; portable-graphical-session-check.el ends here
