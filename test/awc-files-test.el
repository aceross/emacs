;;; awc-files-test.el --- Real file safety and recovery checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'awc-files)
(require 'awc-project)
(require 'awc-research)
(require 'org)
(require 'ob-emacs-lisp)
(require 'ox-html)

(defvar inferior-ess-r-program)
(defconst awc-files-test--source-directory
  (file-name-directory (locate-library "awc-files")))

(defmacro awc-files-test--fixture (&rest body)
  (declare (indent 0))
  `(let* ((root (make-temp-file "awc-files-test-" t))
          (default-directory (file-name-as-directory root))
          (awc-files-recovery-directory (expand-file-name "recovery/" root))
          (awc-research-data-directory (expand-file-name "research/" root))
          (awc-research-vault-directory (expand-file-name "vault/" root))
          (enable-local-variables nil) (enable-local-eval nil)
          (safe-local-variable-values nil) (safe-local-eval-forms nil)
          (safe-local-variable-directories nil) (ignored-local-variable-values nil)
          (dir-local-variables-alist nil) (dir-locals-directory-cache nil)
          (make-backup-files nil) (backup-by-copying nil)
          (backup-directory-alist nil) (vc-make-backup-files nil)
          (version-control nil) (kept-new-versions 0) (kept-old-versions 0)
          (delete-old-versions nil) (auto-save-default nil)
          (auto-save-visited-file-name nil) (auto-save-file-name-transforms nil)
          (auto-save-list-file-prefix nil) (auto-save-list-file-name nil)
          (create-lockfiles nil) (lock-file-name-transforms nil)
          ;; Emacs normally excludes /tmp from backups.  Only our disposable
          ;; fixture is eligible; never relax the production predicate.
          (backup-enable-predicate (lambda (file) (file-in-directory-p file root)))
          (find-file-hook nil) (auto-mode-alist nil)
          ;; after-find-file deliberately skips auto-save setup in batch.
          ;; Exercise the interactive file lifecycle, supplying answers below.
          (noninteractive nil)
          (org-mode-hook nil) (text-mode-hook nil)
          (org-confirm-babel-evaluate t))
     (unwind-protect
         (progn (awc-files-initialize) ,@body)
       (dolist (buffer (buffer-list))
         (when (and (buffer-file-name buffer)
                    (file-in-directory-p (buffer-file-name buffer) root))
           (with-current-buffer buffer
             (set-buffer-modified-p nil)
             (auto-revert-mode -1))
           (kill-buffer buffer)))
       (delete-directory root t))))

(defun awc-files-test--write (file text)
  (make-directory (file-name-directory file) t)
  (with-temp-file file (insert text)))

(defun awc-files-test--read (file)
  (with-temp-buffer (insert-file-contents file) (buffer-string)))

(ert-deftest awc-files-untrusted-local-eval-needs-real-confirmation ()
  (awc-files-test--fixture
    (let* ((file (expand-file-name "untrusted.txt" root))
           (marker (expand-file-name "executed" root))
           (prompts 0))
      (awc-files-test--write
       file (format "Text\n\nLocal Variables:\neval: (write-region \"ran\" nil %S)\nEnd:\n" marker))
      ;; Substitute only keyboard input, keeping the real parser, safety
      ;; classification and confirmation window in the path under test.
      (cl-letf (((symbol-function 'read-char-choice)
                 (lambda (&rest _) (cl-incf prompts) ?n)))
        (let ((noninteractive nil)) (find-file-noselect file)))
      (should (= prompts 1))
      (should-not (file-exists-p marker)))))

(ert-deftest awc-files-directory-interpreters-are-reviewed-and-preserved ()
  (awc-files-test--fixture
    (let ((python (expand-file-name "env with spaces/bin/python" root))
          (r-program "/reviewed/R")
          (inferior-ess-r-program "R")
          (prompts 0))
      (awc-files-test--write python "synthetic executable; never run\n")
      (set-file-modes python #o700)
      (awc-files-test--write (expand-file-name "pyproject.toml" root) "")
      (dolist (variable '(awc-project-python quarto-preview-python))
        (awc-files-test--write
         (expand-file-name ".dir-locals.el" root)
         (format "((nil . ((%s . %S) (inferior-ess-r-program . %S))))"
                 variable "env with spaces/bin/python" r-program))
        (setq dir-locals-directory-cache nil)
        (let ((file (expand-file-name (format "%s.txt" variable) root)))
          (awc-files-test--write file "Project document\n")
          (cl-letf (((symbol-function 'read-char-choice)
                     (lambda (&rest _) (cl-incf prompts) ?y)))
            (let ((noninteractive nil))
              (with-current-buffer (find-file-noselect file)
                (should (equal (awc-project-python) python))
                (should (equal inferior-ess-r-program r-program)))))))
      (should (= prompts 2)))))

(ert-deftest awc-files-rejected-interpreter-does-not-become-trusted ()
  (awc-files-test--fixture
    (awc-files-test--write (expand-file-name ".dir-locals.el" root)
                           "((nil . ((awc-project-python . \"./unreviewed\"))))")
    (let ((file (expand-file-name "document.txt" root)) (prompts 0))
      (awc-files-test--write file "Text\n")
      (cl-letf (((symbol-function 'read-char-choice)
                 (lambda (&rest _) (cl-incf prompts) ?n)))
        (let ((noninteractive nil))
          (with-current-buffer (find-file-noselect file)
            (should-not awc-project-python)
            (should-error (awc-project-python) :type 'user-error))))
      (should (= prompts 1))
      (should-not (safe-local-variable-p 'awc-project-python "./unreviewed")))))

(ert-deftest awc-files-safe-locals-still-work-without-prompts ()
  (awc-files-test--fixture
    (let ((file (expand-file-name "safe.txt" root)))
      (awc-files-test--write file "Text\n\nLocal Variables:\nfill-column: 81\nEnd:\n")
      (cl-letf (((symbol-function 'read-char-choice)
                 (lambda (&rest _) (ert-fail "Safe value prompted"))))
        (let ((noninteractive nil))
          (with-current-buffer (find-file-noselect file)
            (should (= fill-column 81))))))))

(ert-deftest awc-files-document-cannot-silently-disable-babel-confirmation ()
  (awc-files-test--fixture
    (let ((file (expand-file-name "untrusted.org" root)) (prompts 0))
      (awc-files-test--write file "Text\n\n# Local Variables:\n# org-confirm-babel-evaluate: nil\n# End:\n")
      (cl-letf (((symbol-function 'read-char-choice)
                 (lambda (&rest _) (cl-incf prompts) ?n)))
        (with-current-buffer (find-file-noselect file)
          (should org-confirm-babel-evaluate)))
      (should (= prompts 1)))))

(ert-deftest awc-files-babel-denial-export-and-explicit-approval ()
  (awc-files-test--fixture
    (let ((marker (expand-file-name "babel-ran" root)) (prompts 0))
      (with-temp-buffer
        (org-mode)
        (insert (format "#+begin_src emacs-lisp :eval yes :exports results\n(write-region \"ran\" nil %S)\n#+end_src\n" marker))
        (goto-char (point-min))
        (cl-letf (((symbol-function 'yes-or-no-p)
                   (lambda (&rest _) (cl-incf prompts) nil)))
          (org-babel-execute-src-block)
          (org-export-as 'html nil nil t))
        (should (>= prompts 2))
        (should-not (file-exists-p marker))
        (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
          (org-babel-execute-src-block))
        (should (equal "ran" (awc-files-test--read marker)))))))

(ert-deftest awc-files-backup-keeps-original-and-symlink ()
  (awc-files-test--fixture
    (let ((file (expand-file-name "original.txt" root))
          (link (expand-file-name "linked.txt" root))
          (vc-follow-symlinks t))
      (awc-files-test--write file "Original\n")
      (make-symbolic-link file link)
      (with-current-buffer (find-file-noselect link)
        (goto-char (point-max)) (insert "New text\n")
        (save-buffer)
        (let ((backup (car (file-backup-file-names file))))
          (should backup)
          (should (file-in-directory-p backup awc-files-recovery-directory))
          (should (equal "Original\n" (awc-files-test--read backup)))))
      (should (file-symlink-p link))
      (should (equal "Original\nNew text\n" (awc-files-test--read file)))
      (should (= #o700 (file-modes awc-files-recovery-directory)))
      (awc-files-initialize)
      (should (directory-files (expand-file-name "backups" awc-files-recovery-directory) nil "~$")))))

(ert-deftest awc-files-new-document-recovery-and-cancellation ()
  (awc-files-test--fixture
    (let ((file (expand-file-name "not created yet/新 manuscript.txt" root)))
      (with-current-buffer (find-file-noselect file)
        (insert "Unsaved research\n")
        (do-auto-save t t)
        (should-not (file-exists-p file))
        (should (file-in-directory-p buffer-auto-save-file-name awc-files-recovery-directory))
        (should (equal "Unsaved research\n" (awc-files-test--read buffer-auto-save-file-name)))
        (set-buffer-modified-p nil)
        (kill-buffer))
      (cl-letf (((symbol-function 'read-answer) (lambda (&rest _) "no"))
                ((symbol-function 'yes-or-no-p) (lambda (&rest _) nil)))
        (should-error (recover-file file) :type 'user-error))
      (should-not (file-exists-p file))
      (cl-letf (((symbol-function 'read-answer) (lambda (&rest _) "yes"))
                ((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
        (recover-file file))
      (should (equal "Unsaved research\n" (buffer-string)))
      (should (buffer-modified-p))
      (should-not (file-exists-p file)))))

(ert-deftest awc-files-vault-routing-preserves-current-autosave ()
  (awc-files-test--fixture
    (let ((file (expand-file-name "Literature/évidence.md" awc-research-vault-directory)))
      (awc-files-test--write file "Original note\n")
      (with-current-buffer (find-file-noselect file)
        (goto-char (point-max)) (insert "Unsaved note\n")
        (do-auto-save t t)
        (let ((previous buffer-auto-save-file-name))
          (awc-research--protect-note)
          (should (file-in-directory-p buffer-auto-save-file-name awc-research-data-directory))
          (should-not (file-exists-p previous))
          (should (string-match-p "Unsaved note" (awc-files-test--read buffer-auto-save-file-name)))
          (awc-research--protect-note)
          (should (file-exists-p buffer-auto-save-file-name))
          (should auto-revert-mode))))))

(ert-deftest awc-files-external-edits-refresh-clean-not-dirty-notes ()
  (awc-files-test--fixture
    (let ((file (expand-file-name "note.md" awc-research-vault-directory))
          (find-file-hook '(awc-research--protect-note))
          (questions 0))
      (awc-files-test--write file "Original\n")
      (with-current-buffer (find-file-noselect file)
        (awc-files-test--write file "External edit one\n")
        ;; Exercise the real Auto Revert handler without waiting on its timer.
        (auto-revert-handler)
        (should (equal "External edit one\n" (buffer-string)))
        (goto-char (point-max)) (insert "Local unsaved text\n")
        (should (eq t (file-locked-p file)))
        (awc-files-test--write file "External edit two, different length\n")
        (auto-revert-handler)
        (should (string-match-p "Local unsaved text" (buffer-string)))
        (should-not (verify-visited-file-modtime (current-buffer)))
        (cl-letf (((symbol-function 'yes-or-no-p)
                   (lambda (&rest _) (cl-incf questions) nil))
                  ((symbol-function 'y-or-n-p)
                   (lambda (&rest _) (cl-incf questions) nil)))
          (should-error (save-buffer)))
        (should (> questions 0))
        (should (equal "External edit two, different length\n" (awc-files-test--read file)))
        (should (buffer-modified-p))))))

(ert-deftest awc-files-autosave-survives-killed-emacs ()
  (awc-files-test--fixture
    (let* ((file (expand-file-name "crash.txt" root))
           (ready (expand-file-name "ready" root))
           (script (expand-file-name "child.el" root))
           (output (generate-new-buffer " *recovery child*"))
           process)
      (awc-files-test--write file "Saved text\n")
      (awc-files-test--write
       script
       (format "(require 'awc-files)\n(setq awc-files-recovery-directory %S)\n(awc-files-initialize)\n(setq auto-save-list-file-name (concat auto-save-list-file-prefix \"child\"))\n(let ((noninteractive nil)) (find-file %S))\n(goto-char (point-max))\n(insert \"Unsaved before crash\\n\")\n(do-auto-save t)\n(with-temp-file %S (insert \"ready\"))\n(while t (sleep-for 1))\n"
               awc-files-recovery-directory file ready))
      (unwind-protect
          (progn
            (setq process (make-process :name "recovery-child" :buffer output :noquery t
                                        :command (list (expand-file-name invocation-name invocation-directory)
                                                       "-Q" "--batch" "-L" awc-files-test--source-directory "-l" script)))
            (let ((deadline (+ (float-time) 10)))
              (while (and (not (file-exists-p ready)) (process-live-p process)
                          (< (float-time) deadline))
                (accept-process-output process 0.05)))
            (should (file-exists-p ready))
            (should (stringp (file-locked-p file)))
            ;; SIGKILL: no normal exit hooks, saving or cleanup in the child.
            (delete-process process)
            (should (eq (process-status process) 'signal))
            (should (equal "Saved text\n" (awc-files-test--read file)))
            (should (string-match-p "crash.txt" (awc-files-test--read
                                                 (concat auto-save-list-file-prefix "child"))))
            (cl-letf (((symbol-function 'read-answer) (lambda (&rest _) "yes"))
                      ((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
              (recover-file file))
            (should (equal "Saved text\nUnsaved before crash\n" (buffer-string)))
            (should (buffer-modified-p))
            (should (equal "Saved text\n" (awc-files-test--read file))))
        (when (process-live-p process) (delete-process process))
        (kill-buffer output)))))

(provide 'awc-files-test)
