;;; quarto-gui-check.el --- Isolated live GUI acceptance -*- lexical-binding: t; -*-
;; Launch with emacs-xwidgets -Q --load this-file; never use a normal server.
(setq straight-safe-mode t)
(require 'server)
(setq server-name "quarto-source-gui" server-socket-dir "/tmp/quarto-gui-check/server")
(load (expand-file-name "../init.el" (file-name-directory load-file-name)) nil t)
(server-start)
(setq lsp-session-file "/tmp/quarto-gui-check/lsp-session" lsp-restart 'ignore)
(require 'ert)
(defvar quarto-gui-source nil)
(defvar quarto-gui-step 0)
(defvar quarto-gui-start (float-time))
(defvar quarto-gui-window nil)
(defvar quarto-gui-log "/tmp/quarto-gui-check/result.log")
(make-directory "/tmp/quarto-gui-check" t)
(with-temp-file quarto-gui-log (insert ""))
(defun quarto-gui-log (format-string &rest arguments)
  (write-region (concat (apply #'format format-string arguments) "\n") nil quarto-gui-log t 'silent))
(defun quarto-gui-screenshot (name)
  (when (fboundp 'x-export-frames)
    (redisplay t)
    (let ((coding-system-for-write 'no-conversion))
      (write-region (x-export-frames nil 'png) nil (concat "/tmp/quarto-gui-check/" name ".png") nil 'silent))))
(defun quarto-gui-check-tick ()
  (condition-case err
      (progn
        (when (> (- (float-time) quarto-gui-start) 150) (error "GUI test deadline"))
        (set-buffer (window-buffer (if (window-live-p quarto-gui-window) quarto-gui-window (selected-window))))
        (pcase quarto-gui-step
          (0
           (let ((file "/tmp/quarto-runtime-check/project with spaces/reports/nested space/gui.qmd"))
             (with-temp-file file
               (insert "---\ntitle: Quarto source editing\nengine: knitr\nformat: html\n---\n# Source and linked results\n\n```{r}\n#| label: fig-example\nx <- 1:10\nplot(x, x^2)\n```\n\n```{python}\nanswer = 42\nanswer.bit_length()\n```\n"))
             (find-file file) (setq quarto-gui-source (current-buffer) quarto-gui-window (selected-window))
             (setq quarto-gui-step 1)))
          (1
           (with-current-buffer quarto-gui-source
             (when (and (= (length quarto-lsp--documents) 2)
                        (cl-every (lambda (entry) (with-current-buffer (cdr entry)
                                                  (and (car (lsp-workspaces))
                                                       (eq (lsp--workspace-status (car (lsp-workspaces))) 'initialized)))) quarto-lsp--documents))
               (should-not quarto-runtime--process)
               (goto-char (point-min)) (search-forward "answer.")
               (pm-switch-to-buffer (point))
               (should (eq major-mode 'python-mode))
               (should (memq #'quarto-lsp-completion-at-point completion-at-point-functions))
               (corfu-mode 1) (completion-at-point) (corfu--exhibit)
               (quarto-gui-log "Completion buffer %s: mode=%s candidates=%s" (buffer-name) completion-in-region-mode (length corfu--candidates))
               (setq quarto-gui-step 2))))
          (2
           (should (bound-and-true-p completion-in-region-mode))
           (should (member "bit_length" corfu--candidates))
           (should (frame-live-p corfu--frame))
           (quarto-gui-screenshot "completion")
           (quarto-gui-log "PASS actual Python Corfu menu in a polymode chunk")
           (corfu--goto (cl-position "bit_count" corfu--candidates :test #'equal))
           (corfu-insert)
           (with-current-buffer quarto-gui-source
             (should (string-match-p "answer\\.bit_count()" (buffer-string)))
             (should-not (string-match-p "bit_countbit_length" (buffer-string))))
           (quarto-gui-log "PASS accepting a completion replaces the existing member safely")
           (switch-to-buffer quarto-gui-source)
           (goto-char (point-min)) (search-forward "x <-")
           (pm-switch-to-buffer (point))
           (should (eq major-mode 'ess-r-mode))
           (quarto-run-chunk)
           (setq quarto-gui-step 3))
          (3
           (with-current-buffer quarto-gui-source
             (when (and quarto-runtime--results (eq (quarto-request-state (car quarto-runtime--results)) 'succeeded))
               (should (cl-some (lambda (e) (and (equal (quarto-get e "type") "plot") (file-readable-p (quarto-get e "path"))))
                                (quarto-request-events (car quarto-runtime--results))))
               (should (eq (selected-window) quarto-gui-window))
               (let ((count (length (window-list))) (pane quarto-runtime--pane))
                 (quarto-results-show)
                 (should (eq pane quarto-runtime--pane)) (should (= count (length (window-list)))))
               (quarto-gui-screenshot "results")
               (quarto-gui-log "PASS source focus, plot result and side-window reuse")
               (quarto-preview-document)
               (setq quarto-gui-step 4))))
          (4
           (with-current-buffer quarto-gui-source
             (when (buffer-live-p quarto-preview--browser)
               (quarto-gui-screenshot "preview")
               (should (eq (selected-window) quarto-gui-window))
               (quarto-gui-log "PASS live WebKit preview and source focus")
               (quarto-stop-preview)
               (setq quarto-gui-step 5))))
          (5
           (switch-to-buffer quarto-gui-source)
           (goto-char (point-max))
           (let ((start (float-time)))
             (insert (mapconcat (lambda (index) (format "\n## Section %d\nSome research prose.\n\n~~~~{python}\nvalue_%d = %d\n~~~~\n" index index index))
                                (number-sequence 1 250) ""))
             (quarto-document-model) (quarto-document-projection "python")
             (quarto-gui-log "Substantial document: %d characters, paste/index/projection %.3fs" (buffer-size) (- (float-time) start)))
           (let ((start (float-time)))
             (insert "\nEdit\n") (quarto-document-model) (quarto-document-projection "python")
             (should (< (- (float-time) start) 1.0))
             (quarto-gui-log "PASS substantial document edit/index/projection %.3fs" (- (float-time) start)))
           (quarto-gui-log "GUI CHECK COMPLETE")
           (quarto-gui-screenshot "substantial")
           (setq quarto-gui-step 6)))
        (when (< quarto-gui-step 6) (run-at-time 0.5 nil #'quarto-gui-check-tick)))
    (error (quarto-gui-log "FAIL step %d: %s" quarto-gui-step (error-message-string err))
           (quarto-gui-screenshot "failure"))))
(run-at-time 2 nil #'quarto-gui-check-tick)
