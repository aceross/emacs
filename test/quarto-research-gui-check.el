;;; quarto-research-gui-check.el --- Research assistance in real windows -*- lexical-binding: t; -*-
;; Run in a separate graphical Emacs. Only disposable documents are edited.
(setq straight-safe-mode t quarto-lsp-auto-start nil)
(load (expand-file-name "../init.el" (file-name-directory load-file-name)) nil t)
(require 'ert)
(defvar quarto-research-gui-root (make-temp-file "/tmp/quarto-research-gui-" t))
(defvar quarto-research-gui-source nil)
(defvar quarto-research-gui-window nil)
(defvar quarto-research-gui-step 0)
(defvar quarto-research-gui-start (float-time))
(defun quarto-research-gui-log (text)
  (write-region (concat text "\n") nil (expand-file-name "result.log" quarto-research-gui-root) t 'silent))
(defun quarto-research-gui-tick ()
  (condition-case err
      (progn
        (when (> (- (float-time) quarto-research-gui-start) 45) (error "GUI check deadline"))
        (set-buffer (window-buffer (selected-window)))
        (pcase quarto-research-gui-step
          (0
           (with-temp-file (expand-file-name "refs.bib" quarto-research-gui-root)
             (insert "@article{smith2026, author={Smith, Jane}, year={2026}, title={Research methods}}\n"))
           (with-temp-file (expand-file-name "second.bib" quarto-research-gui-root)
             (insert "@book{jones2025, author={Jones, Alex}, year={2025}, title={Another study}}\n"))
           (with-temp-file (expand-file-name "paper.qmd" quarto-research-gui-root)
             (insert "---\ntitle: Research\nbibliography: refs.bib\n---\n![Measured values](plot.png){#fig-data}\nSee @fig-data. Cite @"))
           (find-file (expand-file-name "paper.qmd" quarto-research-gui-root))
           (setq quarto-research-gui-source (current-buffer) quarto-research-gui-window (selected-window)
                 quarto-research-gui-step 1)
           (goto-char (point-max)))
          (1
           (when (member "smith2026" quarto-authoring--citations)
             (setq unread-command-events (append (listify-key-sequence "smi") unread-command-events)
                   quarto-research-gui-step 2)))
          (2
           (when (and completion-in-region-mode (member "smith2026" corfu--candidates)
                      (frame-live-p corfu--frame) (frame-visible-p corfu--frame))
             (should (eq (selected-window) quarto-research-gui-window))
             (should (string-match-p "Smith, Jane.*2026.*Research methods"
                                     (funcall (plist-get (nth 4 completion-in-region--data) :annotation-function) "smith2026")))
             (let ((coding-system-for-write 'no-conversion))
               (write-region (x-export-frames (list corfu--frame) 'png) nil
                             (expand-file-name "citation-menu.png" quarto-research-gui-root) nil 'silent))
             (corfu--goto (cl-position "smith2026" corfu--candidates :test #'equal)) (corfu-insert)
             (should (string-suffix-p "@smith2026" (buffer-string)))
             (quarto-research-gui-log "PASS citation menu, descriptions, acceptance and source focus")
             (goto-char 1) (search-forward "#fig-data") (quarto-rename "fig-updated")
             (should (string-match-p "See @fig-updated" (buffer-string)))
             (quarto-research-gui-log "PASS label rename updates the definition and its reference")
             (goto-char 1) (search-forward "refs.bib") (replace-match "second.bib")
             (setq quarto-research-gui-step 3)))
          (3
           (when (equal '("jones2025") quarto-authoring--citations)
             (quarto-research-gui-log "PASS bibliography refresh after unsaved metadata edits")
             (goto-char (point-max))
             (quarto-document-status)
             (setq quarto-research-gui-step 4)))
          (4
           (when (string-prefix-p "Ready" quarto-health--yaml)
             (should (eq (selected-window) quarto-research-gui-window))
             (should (get-buffer-window quarto-health--report))
             (should (equal "1.4.530" quarto-health--version))
             (let ((coding-system-for-write 'no-conversion))
               (redisplay t)
               (write-region (x-export-frames nil 'png) nil
                             (expand-file-name "readiness.png" quarto-research-gui-root) nil 'silent))
             (quarto-research-gui-log "PASS asynchronous readiness report keeps source focus")
             (with-current-buffer quarto-health--report
               (goto-char 1) (search-forward "Repair completion hooks")
               (button-activate (button-at (1- (point)))))
             (setq quarto-research-gui-step 5)))
          (5
           (when (string-prefix-p "Ready" quarto-health--yaml)
             (should-not quarto-runtime--process)
             (should (memq #'quarto-reference-completion-at-point completion-at-point-functions))
             (quarto-research-gui-log "PASS recovery button restores completion without executing code")
             (quarto-research-gui-log "GUI CHECK COMPLETE")
             (setq quarto-research-gui-step 6)
             (with-current-buffer quarto-research-gui-source (set-buffer-modified-p nil))
             (run-at-time 0.2 nil #'kill-emacs))))
        (when (< quarto-research-gui-step 6) (run-at-time 0.1 nil #'quarto-research-gui-tick)))
    (error (quarto-research-gui-log (format "FAIL step %d: %s" quarto-research-gui-step (error-message-string err)))
           (when (buffer-live-p quarto-research-gui-source)
             (with-current-buffer quarto-research-gui-source (set-buffer-modified-p nil)))
           (kill-emacs 1))))
(message "Quarto GUI check logs: %s" quarto-research-gui-root)
(run-at-time 1 nil #'quarto-research-gui-tick)
