;;; quarto-assistance-integration.el --- Real Quarto schemas and language servers -*- lexical-binding: t; -*-
;; First prepare test/r-lsp-fixtures.R in AWC_R_LSP_TEST_DIR.
(load (expand-file-name "quarto-test-setup.el" (file-name-directory load-file-name)) nil t)
(require 'lsp-mode)
(defvar quarto-test-base (or (getenv "AWC_R_LSP_TEST_DIR") "/tmp/awc-r-lsp-final"))
(defvar quarto-test-sources nil)
(defun quarto-test-position (text)
  (goto-char (point-min)) (search-forward text))
(unwind-protect
    (progn
      (dolist (label '("alpha" "beta"))
        (let* ((root (expand-file-name (concat "project " label) quarto-test-base))
               (file (expand-file-name "reports/chapters/intelligence.qmd" root))
               (text "---\ntitle: Intelligence\nformat: html\n---\n# Prose λ {#sec-test}\n\n~~~{r}\n#| label: first\nproject_calculate <- function(x) x + 1\nvalue <- 1\n~~~\n\n~~~{r}\nresult <- project_calculate(value)\nenvprobe::\nbad = 2\n~~~\n\n```{python}\ndef calculate(x: int) -> int:\n    return x + 1\n```\n\n```{python}\nanswer = calculate(2)\nanswer.\n```\n"))
          (unless (and (string-prefix-p "/tmp/" root) (file-exists-p (expand-file-name "fixture.Rproj" root)))
            (error "Prepare disposable R LSP fixtures first"))
          (let* ((python (expand-file-name ".venv/bin/python" root))
                 (library (car (process-lines python "-c" "import sysconfig; print(sysconfig.get_path('purelib'))"))))
            (with-temp-file (expand-file-name "quarto_envprobe.py" library)
              (insert (format "def %s_only() -> int:\n    return 42\n" label))))
          (with-temp-file file
            (insert (replace-regexp-in-string
                     "def calculate" (concat "import quarto_envprobe\nquarto_envprobe." label "_only()\ndef calculate")
                     (replace-regexp-in-string "envprobe::\n" (concat "envprobe::" label "_only()\n") text t t) t t)))
          (let ((source (find-file-noselect file)))
            (push source quarto-test-sources)
            (with-current-buffer source
              (quarto-lsp-start)
              (when quarto-lsp-error (error "%s" quarto-lsp-error))
              (dolist (entry quarto-lsp--documents)
                (quarto-test-wait (lambda () (with-current-buffer (cdr entry)
                                               (and (car (lsp-workspaces))
                                                    (eq (lsp--workspace-status (car (lsp-workspaces))) 'initialized)))) "LSP initialisation"))
              (quarto-test-position "envprobe::")
              (quarto-test-wait (lambda () (member (concat label "_only") (nth 2 (quarto-lsp-completion-at-point)))) "R completion")
              (should-not (member (concat (if (equal label "alpha") "beta" "alpha") "_only")
                                  (nth 2 (quarto-lsp-completion-at-point))))
              (quarto-test-position "result <- project_calc")
              (quarto-test-wait (lambda () (quarto-lsp-xrefs "textDocument/definition")) "cross-chunk R definition")
              (should (quarto-lsp-xrefs "textDocument/references"))
              (let* ((hover (cdr (quarto-lsp--request "textDocument/hover"))))
                (should (quarto-get hover "contents")))
              (quarto-rename "renamed_calculate")
              (should (string-match-p "function(x)" (buffer-string)))
              (should (= 2 (how-many "renamed_calculate" (point-min) (point-max))))
              (goto-char 1) (insert "<!-- 😀 moving all chunks -->\n")
              (quarto-lsp--sync source)
              (quarto-test-position "result <- renamed_calc")
              (quarto-test-wait (lambda () (quarto-lsp-xrefs "textDocument/definition")) "definition after moving chunks")
              (quarto-test-position "answer = calc")
              (quarto-test-wait (lambda () (quarto-lsp-xrefs "textDocument/definition")) "cross-chunk Python definition")
              (should (quarto-lsp-xrefs "textDocument/references"))
              (should (quarto-get (cdr (quarto-lsp--request "textDocument/hover")) "contents"))
              (quarto-rename "calculate_value")
              (should (= 2 (how-many "calculate_value" (point-min) (point-max))))
              (quarto-test-position "quarto_envprobe.")
              (quarto-test-wait (lambda () (member (concat label "_only") (nth 2 (quarto-lsp-completion-at-point)))) "Python environment-specific completion")
              (should-not (member (concat (if (equal label "alpha") "beta" "alpha") "_only")
                                  (nth 2 (quarto-lsp-completion-at-point))))
              (quarto-test-position "answer.")
              (let ((capf (quarto-lsp-completion-at-point)))
                (should (= (point) (car capf)))
                (should (member "bit_length" (all-completions "" (nth 2 capf)))))
              (quarto-test-wait (lambda () (quarto-lsp--diagnostics) quarto-lsp-diagnostics) "mapped diagnostics")
              (princ (format "PASS %s: R/Python completion, hover, cross-chunk definition/reference/rename, moved boundaries\n" label))))))
      (with-temp-buffer
        (insert "---\nformat: html\necho: not-a-boolean\n---\n")
        (let ((source (current-buffer)))
          (quarto-yaml-refresh source)
          (quarto-test-wait (lambda () (or quarto-yaml-diagnostics quarto-yaml-error)) "schema lint")
          (when quarto-yaml-error (error "%s" quarto-yaml-error))
          (should (= 3 (line-number-at-pos (caar quarto-yaml-diagnostics)))))
        (goto-char (point-min)) (forward-line 1) (end-of-line)
        (quarto-test-wait (lambda () (member "html" (nth 2 (quarto-yaml-completion-at-point)))) "YAML format completion")
        (princ "PASS Quarto 1.4 schema completion and validation\n"))
      (dolist (fixture '(("/tmp/schema.qmd" . "```{r}\n#| echo: not-a-boolean\n1 + 1\n```\n")
                         ("/tmp/_quarto.yml" . "project:\n  type: default\nexecute:\n  echo: not-a-boolean\n")))
        (with-temp-buffer
          (setq buffer-file-name (car fixture)) (insert (cdr fixture))
          (quarto-yaml-refresh (current-buffer))
          (quarto-test-wait (lambda () (or quarto-yaml-diagnostics quarto-yaml-error)) "chunk/project YAML lint")
          (should-not quarto-yaml-error)
          (should (string-match-p "echo" (nth 2 (car quarto-yaml-diagnostics))))))
      (princ "PASS YAML chunk options and project configuration diagnostics\n"))
  (dolist (source quarto-test-sources)
    (when (buffer-live-p source) (with-current-buffer source (set-buffer-modified-p nil)) (kill-buffer source)))
  (dolist (workspace (lsp--session-workspaces (lsp-session))) (ignore-errors (lsp-workspace-shutdown workspace)))
  (dolist (buffer (buffer-list))
    (when (string-match-p "stderr" (buffer-name buffer))
      (princ (format "LOG %s\n%s\n" (buffer-name buffer) (with-current-buffer buffer (buffer-string))))))
  (when (process-live-p quarto-yaml--process) (delete-process quarto-yaml--process)))
