;;; quarto-yaml-test.el --- Responsive schema completion checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'quarto-mode)

(ert-deftest quarto-yaml-asynchronous-replies-are-revision-and-position-scoped ()
  (with-temp-buffer
    (insert "---\nti\n---\nProse\n") (goto-char 7)
    (let (callbacks)
      (cl-letf (((symbol-function 'quarto-yaml-request)
                 (lambda (_method _payload callback) (push callback callbacks)))
                ((symbol-function 'accept-process-output)
                 (lambda (&rest _) (ert-fail "Completion must never wait for a process"))))
        (should-not (nth 2 (quarto-yaml-completion-at-point)))
        (quarto-yaml-completion-at-point)
        (should (= 1 (length callbacks)))
        (let ((old (car callbacks)))
          (insert "t") (quarto-yaml-completion-at-point)
          (should (= 2 (length callbacks)))
          (funcall old (json-parse-string "{\"completions\":[{\"value\":\"old\"}]}") nil)
          (should-not quarto-yaml--completion)
          (goto-char (point-max))
          (funcall (car callbacks) (json-parse-string "{\"completions\":[{\"value\":\"title: \"}]}") nil)
          (should-not quarto-yaml--completion)
          (should-not quarto-yaml--completion-request)
          (goto-char 8) (quarto-yaml-completion-at-point)
          (should (= 3 (length callbacks))))))))

(ert-deftest quarto-yaml-ui-settings-stay-local-to-yaml ()
  (with-temp-buffer
    (insert "---\nti\n---\nProse\n```{python}\n#| fig-wi\nx = 1\n```\n")
    (let ((original-prefix corfu-auto-prefix) (original-delay corfu-auto-delay)
          (original-popup corfu-popupinfo-mode))
      (goto-char 7) (quarto-yaml-setup)
      (should (= corfu-auto-prefix 2)) (should (= corfu-auto-delay 0.25))
      (should corfu-popupinfo-mode)
      (search-forward "Prose") (quarto-yaml--post-command)
      (should (= corfu-auto-prefix original-prefix))
      (should (= corfu-auto-delay original-delay))
      (should (eq corfu-popupinfo-mode original-popup))
      (search-forward "fig-wi") (quarto-yaml--post-command)
      (should (= corfu-auto-prefix 2))
      (search-forward "x =") (quarto-yaml--post-command)
      (should (= corfu-auto-prefix original-prefix)))))

(ert-deftest quarto-yaml-context-normalises-containers-and-keeps-metadata ()
  (with-temp-buffer
    (insert "---\nengine: knitr\nformat: pdf\n---\n> - ~~~~{python}\n>   #| fig-wi\n>   x = 1\n>   ~~~~\n")
    (goto-char 1) (search-forward "fig-wi")
    (let ((context (quarto-yaml-context nil t)))
      (should (equal (plist-get context :line) "#| fig-wi"))
      (should (equal (plist-get context :position) '(:row 1 :column 9)))
      (should (string-prefix-p "```{python}\n" (plist-get context :code)))
      (should (string-match-p "engine: knitr" (plist-get context :metadata))))))

(ert-deftest quarto-yaml-excludes-delimiters-prose-and-example-chunks ()
  (with-temp-buffer
    (insert "---\ntitle: Example\n---\n")
    (goto-char (point-max)) (should-not (quarto-yaml-position-p))
    (goto-char 2) (should-not (quarto-yaml-position-p))
    (goto-char (point-max)) (insert "```r\n#| fig-wi\n```\n")
    (search-backward "fig-wi") (should-not (quarto-yaml-position-p)))
  (with-temp-buffer
    (insert "---\nti")
    (should (quarto-yaml-position-p))
    (should (eq t (plist-get (quarto-yaml-context nil t) :front_matter_open)))))

(ert-deftest quarto-yaml-request-failure-finishes-once ()
  (let ((quarto-yaml--pending (make-hash-table :test #'eql))
        (quarto-yaml--timeouts (make-hash-table :test #'eql)) replies)
    (puthash 1 (lambda (value error) (push (list value error) replies)) quarto-yaml--pending)
    (quarto-yaml--finish-request 1 nil "Timed out")
    (quarto-yaml--finish-request 1 'late nil)
    (should (equal replies '((nil "Timed out"))))
    (should (zerop (hash-table-count quarto-yaml--pending)))))

(ert-deftest quarto-yaml-dismissal-discards-a-pending-menu ()
  (with-temp-buffer
    (insert "---\nti\n---\n") (goto-char 7)
    (let (reply)
      (cl-letf (((symbol-function 'quarto-yaml-request)
                 (lambda (_method _payload callback) (setq reply callback))))
        (quarto-yaml-completion-at-point)
        (let ((this-command 'keyboard-escape-quit)) (quarto-yaml--post-command))
        (funcall reply (json-parse-string "{\"completions\":[{\"value\":\"title: \"}]}") nil)
        (should-not quarto-yaml--completion)))))

(ert-deftest quarto-yaml-project-files-select-an-available-editor ()
  (with-temp-buffer
    (setq buffer-file-name "/tmp/_quarto-draft.yml")
    (cl-letf (((symbol-function 'quarto-yaml-request) #'ignore))
      (set-auto-mode))
    (should (memq #'quarto-yaml-completion-at-point completion-at-point-functions))
    (should (memq #'quarto-yaml-eldoc eldoc-documentation-functions))
    (should (eq flycheck-checker 'quarto))))

(ert-deftest quarto-yaml-new-document-does-not-require-a-saved-file ()
  (let* ((directory (make-temp-file "quarto-new-document-" t))
         (file (expand-file-name "new.qmd" directory))
         (quarto-lsp-auto-start nil) buffer inspected)
    (unwind-protect
        (cl-letf (((symbol-function 'quarto-yaml-request) #'ignore)
                  ((symbol-function 'quarto-authoring-refresh-bibliographies)
                   (lambda ()
                     (should (file-readable-p buffer-file-name))
                     (setq inspected t))))
          (setq buffer (find-file-noselect file))
          (with-current-buffer buffer
            (should-not inspected)
            (should (memq #'quarto-yaml-completion-at-point completion-at-point-functions))
            (insert "---\nti\n---\n") (goto-char 7)
            (should (quarto-yaml-position-p))
            (save-buffer)
            (should inspected)
            (should-not (memq #'quarto-after-first-save after-save-hook))))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (set-buffer-modified-p nil)) (kill-buffer buffer))
      (delete-directory directory t))))

(provide 'quarto-yaml-test)
