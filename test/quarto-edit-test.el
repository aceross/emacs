;;; quarto-edit-test.el --- Exercise actual polymode spans -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'quarto-mode)
(require 'awc-python)
(require 'awc-r)

(ert-deftest quarto-edit-execution-at-boundaries-and-in-prose ()
  (with-temp-buffer
    (insert "Prose\n\n```{python}\nvalue = 42\n```\n\nAfter\n\n```{r}\nvalue <- 7\n```\n")
    (poly-quarto-mode)
    (let (python-sent r-sent)
      (cl-letf (((symbol-function 'quarto-execution-request)
                 (lambda (chunks &rest _)
                   (let ((chunk (car chunks)))
                     (pcase (quarto-chunk-language chunk)
                       ("python" (push (quarto-chunk-code chunk) python-sent))
                       ("r" (push (quarto-chunk-code chunk) r-sent)))))))
        ;; Opening fence, first body character, closing fence.
        (dolist (line '(3 4 5))
          (goto-char (point-min)) (forward-line (1- line))
          (quarto-send-code-block-to-repl))
        (should (equal python-sent '("value = 42\n" "value = 42\n" "value = 42\n")))
        (goto-char (point-min)) (forward-line 3)
        (let* ((span (pm-innermost-span)) (chunk (pm-span-buffer span)))
          (with-current-buffer chunk
            (goto-char (nth 1 span)) (quarto-send-code-block-to-repl)))
        (should (= (length python-sent) 4))
        (dolist (line '(9 10 11))
          (goto-char (point-min)) (forward-line (1- line))
          (quarto-send-code-block-to-repl))
        (should (equal r-sent '("value <- 7\n" "value <- 7\n" "value <- 7\n")))
        (goto-char (point-min))
        (should-error (quarto-send-code-block-to-repl) :type 'user-error)
        (forward-line 6)
        (should-error (quarto-send-code-block-to-repl) :type 'user-error)))))

(ert-deftest quarto-edit-navigation-crosses-narrowed-language-buffers ()
  (save-window-excursion
    (let ((source (generate-new-buffer " *quarto navigation*")))
      (unwind-protect
          (progn
            (switch-to-buffer source)
            (insert "Prose\n```{python}\nx = 1\n```\n\n~~~{r}\nx <- 2\n~~~\n")
            (poly-quarto-mode)
            (let* ((chunks (quarto-document-chunks (quarto-document-model)))
                   (first (car chunks)) (second (cadr chunks)))
              (quarto-goto-source-position (quarto-chunk-head-end first))
              (should (derived-mode-p 'python-mode))
              (narrow-to-region (quarto-chunk-head-end first) (quarto-chunk-body-end first))
              (quarto-next-chunk)
              (should (= (point) (quarto-chunk-start second)))
              (quarto-select-chunk)
              (should (derived-mode-p 'ess-r-mode))
              (should (= (point) (quarto-chunk-head-end second)))
              (should (= (mark) (quarto-chunk-body-end second)))
              (quarto-fold-chunk)
              (quarto-goto-source-position (quarto-chunk-start second))
              (quarto-fold-chunk)
              (should-not (buffer-local-value 'quarto-authoring--folds (quarto-source-buffer)))
              (quarto-select-chunk)
              (narrow-to-region (point) (mark))
              (quarto-previous-chunk)
              (should (= (point) (quarto-chunk-start second)))
              (quarto-previous-chunk)
              (should (= (point) (quarto-chunk-start first)))))
        (when (buffer-live-p source) (kill-buffer source))))))

(provide 'quarto-edit-test)
;;; quarto-edit-test.el ends here
