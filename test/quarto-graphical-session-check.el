;;; quarto-graphical-session-check.el --- Real GUI and active soak -*- lexical-binding: t; -*-
;; Loaded after the fixture's normal graphical init. Never loads the live init.
(require 'ert)
(require 'json)
(require 'xwidget)
(defvar awc-gui-phase 'open)
(defvar awc-gui-phase-start (float-time))
(defvar awc-gui-start (float-time))
(defvar awc-gui-soak-start nil)
(defvar awc-gui-soak-end nil)
(defvar awc-gui-cycles 0)
(defvar awc-gui-seconds (string-to-number (getenv "AWC_GUI_SECONDS")))
(defvar awc-gui-interval (string-to-number (or (getenv "AWC_GUI_INTERVAL") "60")))
(defvar awc-gui-settle-start nil)
(defvar awc-gui-sources nil)
(defvar awc-gui-window nil)
(defvar awc-gui-heartbeat nil)
(defvar awc-gui-last-beat nil)
(defvar awc-gui-max-gap 0)
(defvar awc-gui-dom nil)
(defvar awc-gui-dom-pending nil)
(defvar awc-gui-plot-process nil)
(defvar awc-gui-initial-resources nil)
(defvar awc-gui-preview-urls nil)
(defvar awc-gui-result-directories nil)
(defvar awc-gui-interrupt-processes nil)
(defvar awc-gui-finished nil)
(defun awc-gui-log (format-string &rest arguments)
  (write-region (concat (apply #'format format-string arguments) "\n") nil
                (expand-file-name "result.log" awc-gui-root) t 'silent))
(defun awc-gui-source (key) (alist-get key awc-gui-sources))
(defun awc-gui-open (key file text)
  (should (file-in-directory-p file (getenv "QUARTO_TEST_RUN_DIR")))
  (with-temp-file file (insert text))
  (let ((source (find-file-noselect file)))
    (push (cons key source) awc-gui-sources) source))
(defun awc-gui-phase (phase)
  (setq awc-gui-phase phase awc-gui-phase-start (float-time))
  (awc-gui-log "PHASE %s at %.1fs" phase (- (float-time) awc-gui-start)))
(defun awc-gui-screenshot (name)
  (redisplay t)
  (let ((coding-system-for-write 'no-conversion))
    (write-region (x-export-frames nil 'png) nil
                  (expand-file-name (concat name ".png") awc-gui-root) nil 'silent)
    (when (and (frame-live-p corfu--frame) (frame-visible-p corfu--frame))
      (write-region (x-export-frames (list corfu--frame) 'png) nil
                    (expand-file-name (concat name "-menu.png") awc-gui-root) nil 'silent))))
(defun awc-gui-beat ()
  (let* ((now (float-time)) (gap (if awc-gui-last-beat (- now awc-gui-last-beat) 0)))
    (when awc-gui-soak-start (setq awc-gui-max-gap (max gap awc-gui-max-gap)))
    (setq awc-gui-last-beat now)
    (write-region (concat (json-serialize (list :elapsed (- now awc-gui-start) :gap gap
                                               :phase (symbol-name awc-gui-phase))) "\n") nil
                  (expand-file-name "heartbeat.jsonl" awc-gui-root) t 'silent)))
(defun awc-gui-resources (label)
  (let ((record (list :label label :elapsed (- (float-time) awc-gui-start)
                      :buffers (length (buffer-list)) :frames (length (frame-list))
                      :processes (vconcat (mapcar #'process-name (cl-remove-if-not #'process-live-p (process-list))))
                      :timers (length timer-list) :idle_timers (length timer-idle-list)
                      :timer_functions (let ((print-level 3) (print-length 4))
                                         (vconcat (mapcar (lambda (timer) (format "%S" (timer--function timer))) timer-list)))
                      :yaml_pending (hash-table-count quarto-yaml--pending)
                      :yaml_timeouts (hash-table-count quarto-yaml--timeouts)
                      :rss_kib (or (alist-get 'rss (process-attributes (emacs-pid))) 0)
                      :gcs gcs-done :gc_seconds gc-elapsed)))
    (write-region (concat (json-serialize record) "\n") nil
                  (expand-file-name "resources.jsonl" awc-gui-root) t 'silent)
    record))
(defun awc-gui-dom-check (browser script)
  (unless awc-gui-dom-pending
    (setq awc-gui-dom-pending t)
    (with-current-buffer browser
      (xwidget-webkit-execute-script
       (xwidget-webkit-current-session) script
       (lambda (value) (setq awc-gui-dom value awc-gui-dom-pending nil))))))
(defun awc-gui-ready (key)
  (with-current-buffer (awc-gui-source key)
    (when (eq quarto-runtime--state 'failed) (error "%s runtime failed" key))
    (and (eq quarto-runtime--state 'ready) (not quarto-runtime--current)
         (not quarto-runtime--queue))))
(defun awc-gui-listening-p (url)
  (let ((parsed (url-generic-parse-url url)) process)
    (unwind-protect
        (condition-case nil
            (progn (setq process (open-network-stream "gui-port-probe" nil (url-host parsed) (url-port parsed)))
                   (process-live-p process))
          (file-error nil))
      (when (processp process) (delete-process process)))))
(defun awc-gui-cleanup ()
  (let ((browsers (delq nil (append
                           (list (and (processp awc-gui-plot-process) (process-get awc-gui-plot-process 'awc-httpgd-browser)))
                           (mapcar (lambda (entry) (and (buffer-live-p (cdr entry))
                                                       (buffer-local-value 'quarto-preview--browser (cdr entry)))) awc-gui-sources)))))
    (dolist (browser browsers)
      (when (buffer-live-p browser)
        (dolist (widget (get-buffer-xwidgets browser)) (set-xwidget-query-on-exit-flag widget nil))
        (kill-buffer browser))))
  (dolist (entry awc-gui-sources)
    (when (buffer-live-p (cdr entry))
      (with-current-buffer (cdr entry)
        (when quarto-runtime--directory (push quarto-runtime--directory awc-gui-result-directories))
        (when quarto-preview--url (push quarto-preview--url awc-gui-preview-urls))
        (quarto-stop-preview) (quarto-stop-render) (quarto-runtime-stop)
        (set-buffer-modified-p nil))
      (kill-buffer (cdr entry))))
  (dolist (workspace (lsp--session-workspaces (lsp-session))) (lsp-workspace-shutdown workspace))
  (when (process-live-p awc-gui-plot-process) (delete-process awc-gui-plot-process))
  (when-let* ((process (get-process "ispell"))) (delete-process process))
  (when (process-live-p quarto-yaml--process) (delete-process quarto-yaml--process)))
(defun awc-gui-finish (&optional failure)
  (unless awc-gui-finished
    (setq awc-gui-finished t)
    (when (timerp awc-gui-heartbeat) (cancel-timer awc-gui-heartbeat))
    (awc-gui-log "%s %s" (if failure "FAIL" "PASS") (or failure "graphical functional checks, active soak and cleanup"))
    (let ((record (list :status (if failure "failed" "passed") :failure (or failure :null)
                        :emacs emacs-version :window_system (symbol-name window-system)
                        :elapsed_seconds (- (float-time) awc-gui-start)
                        :soak_seconds (if awc-gui-soak-start (- (or awc-gui-soak-end (float-time)) awc-gui-soak-start) 0)
                        :cycles awc-gui-cycles :max_heartbeat_gap awc-gui-max-gap
                        :warnings (vconcat (reverse awc-gui-warnings)))))
      (with-temp-file (expand-file-name "result.json" awc-gui-root) (insert (json-serialize record) "\n")))
    (with-temp-file (expand-file-name "messages.log" awc-gui-root)
      (insert (with-current-buffer "*Messages*" (buffer-string))))
    (when failure (ignore-errors (awc-gui-screenshot "failure")) (ignore-errors (awc-gui-cleanup)))
    (kill-emacs (if failure 1 0))))

(defun awc-gui-tick ()
  (condition-case err
      (progn
        (unless (display-graphic-p) (error "A real graphical frame is required"))
        (set-buffer (window-buffer (selected-window)))
        (when (> (- (float-time) awc-gui-phase-start) (if (eq awc-gui-phase 'soak) (+ awc-gui-seconds 60) 150))
          (error "Graphical phase timed out: %s" awc-gui-phase))
        (pcase awc-gui-phase
          ('open
           (should-not init-file-had-error)
           (should-not awc-gui-warnings)
           (should-not native-comp-jit-compilation)
           (should-not (cl-some (lambda (process) (string-prefix-p "Compiling:" (process-name process))) (process-list)))
           (server-start)
           (should (eq enable-local-variables t))
           (should (eq org-confirm-babel-evaluate t))
           (should (file-in-directory-p custom-file awc-gui-root))
           (setq lsp-session-file (expand-file-name "lsp-session" awc-gui-root) lsp-restart 'ignore)
           (setq awc-gui-window (selected-window))
           (dolist (label '("alpha" "beta"))
             (let* ((root (expand-file-name (concat "project " label) (getenv "AWC_R_LSP_TEST_DIR")))
                    (key (intern label)))
               (awc-gui-open key (expand-file-name "reports/chapters/gui.qmd" root)
                             (format "---\ntitle: GUI %s\n---\n# Completion and environment\n```{r}\nidentity <- envprobe::%s_only()\n```\n```{python}\nanswer = 42\nanswer.bit_length()\n```\n" label label))))
           (switch-to-buffer (awc-gui-source 'alpha))
           (awc-gui-phase 'language))
          ('language
           (when (cl-every
                  (lambda (key) (with-current-buffer (awc-gui-source key)
                                  (and (= (length quarto-lsp--documents) 2)
                                       (cl-every (lambda (entry) (with-current-buffer (cdr entry)
                                                                  (cl-some (lambda (workspace) (eq (lsp--workspace-status workspace) 'initialized))
                                                                           (lsp-workspaces)))) quarto-lsp--documents)))) '(alpha beta))
             (dolist (key '(alpha beta))
               (with-current-buffer (awc-gui-source key)
                 (goto-char (point-min)) (search-forward "envprobe::")
                 (should (member (concat (symbol-name key) "_only") (nth 2 (quarto-lsp-completion-at-point))))))
             (switch-to-buffer (awc-gui-source 'alpha))
             (goto-char (point-min)) (search-forward "answer.") (pm-switch-to-buffer (point))
             (corfu-mode 1) (completion-at-point) (corfu--exhibit)
             (awc-gui-phase 'python-menu)))
          ('python-menu
           (when (and completion-in-region-mode (frame-live-p corfu--frame)
                      (frame-visible-p corfu--frame) (member "bit_count" corfu--candidates))
             (corfu--goto (cl-position "bit_count" corfu--candidates :test #'equal))
             (corfu--exhibit) (awc-gui-screenshot "python-completion") (corfu-insert)
             (with-current-buffer (awc-gui-source 'alpha)
               (should (string-match-p "answer\\.bit_count()" (buffer-string))))
             (awc-gui-log "PASS two-project renv/Python LSP and visible Corfu acceptance")
             (let ((quarto-lsp-auto-start nil))
               (find-file (expand-file-name "new-draft.qmd" awc-gui-root))
               (push (cons 'yaml (quarto-source-buffer)) awc-gui-sources))
             (setq unread-command-events (append (listify-key-sequence "---\nti") unread-command-events))
             (awc-gui-phase 'yaml-menu)))
          ('yaml-menu
           (when (and completion-in-region-mode (frame-live-p corfu--frame)
                      (frame-visible-p corfu--frame) (member "title: " corfu--candidates))
             (awc-gui-screenshot "yaml-completion")
             (corfu--goto (cl-position "title: " corfu--candidates :test #'equal)) (corfu-insert)
             (should (equal (buffer-string) "---\ntitle: "))
             (insert "GUI draft\n---\nSome prose.\n")
             (awc-gui-log "PASS automatic YAML menu in a genuinely new file")
             (let ((root (getenv "QUARTO_TEST_RUNTIME_ROOT")) (quarto-lsp-auto-start nil))
               (awc-gui-open 'knitr (expand-file-name "reports/nested space/gui-knitr.qmd" root)
                             "---\ntitle: Graphical R\nengine: knitr\n---\n```{r}\nx <- 41\nplot(1:5, (1:5)^2, col='steelblue', main='Disposable R plot')\n```\n```{python}\nprint(r.x + 1)\n```\n")
               (awc-gui-open 'jupyter (expand-file-name "reports/nested space/gui-jupyter.qmd" root)
                             "---\ntitle: Graphical Jupyter\njupyter: quarto-fixture\n---\n```{python}\nvalue = 42\nprint(value)\n```\n")
               (awc-gui-open 'preview (expand-file-name "reports/nested space/gui-preview.qmd" root)
                             "---\ntitle: Graphical preview\nformat: html\n---\n# GUI_PREVIEW_READY\n\nA disposable live WebKit preview.\n"))
             (switch-to-buffer (awc-gui-source 'knitr))
             (let ((window (selected-window)))
               (quarto-run-all) (should (eq window (selected-window))))
             (with-current-buffer (awc-gui-source 'jupyter) (quarto-run-all))
             (awc-gui-phase 'results)))
          ('results
           (when (and (awc-gui-ready 'knitr) (awc-gui-ready 'jupyter))
             (with-current-buffer (awc-gui-source 'knitr)
               (should (cl-some (lambda (request) (cl-some (lambda (event) (equal "plot" (quarto-get event "type")))
                                                         (quarto-request-events request))) quarto-runtime--results)))
             (with-current-buffer (awc-gui-source 'jupyter)
               (should (equal "quarto-fixture" (quarto-get quarto-runtime--identity "kernel"))))
             (switch-to-buffer (awc-gui-source 'knitr))
             (let ((pane quarto-runtime--pane) (windows (length (window-list))) (window (selected-window)))
               (quarto-results-show) (should (eq pane quarto-runtime--pane))
               (should (= windows (length (window-list)))) (should (eq window (selected-window))))
             (awc-gui-screenshot "r-results")
             (dolist (key '(knitr jupyter))
               (with-current-buffer (awc-gui-source key)
                 (push quarto-runtime--process awc-gui-interrupt-processes)
                 (goto-char (point-max))
                 (insert (if (eq key 'knitr)
                             "\n```{r}\n#| eval: false\ncat('GUI_INTERRUPT_START\\n'); Sys.sleep(20)\n```\n"
                           "\n```{python}\n#| eval: false\nimport time; print('GUI_INTERRUPT_START', flush=True); time.sleep(20)\n```\n"))
                 (forward-line -2) (quarto-run-chunk)))
             (awc-gui-phase 'interrupt)))
          ('interrupt
           (when (cl-every (lambda (key)
                            (with-current-buffer (awc-gui-source key)
                              (cl-some (lambda (event) (string-match-p "GUI_INTERRUPT_START" (quarto-get event "text" "")))
                                       (quarto-request-events (car (last quarto-runtime--results)))))) '(knitr jupyter))
             (dolist (key '(knitr jupyter)) (with-current-buffer (awc-gui-source key) (quarto-interrupt)))
             (awc-gui-phase 'interrupted)))
          ('interrupted
           (when (and (awc-gui-ready 'knitr) (awc-gui-ready 'jupyter))
             (dolist (key '(knitr jupyter))
               (with-current-buffer (awc-gui-source key)
                 (should (eq (quarto-request-state (car (last quarto-runtime--results))) 'interrupted))
                 (should (memq quarto-runtime--process awc-gui-interrupt-processes))
                 (quarto-run-all)))
             (awc-gui-phase 'recovered)))
          ('recovered
           (when (and (awc-gui-ready 'knitr) (awc-gui-ready 'jupyter))
             (dolist (key '(knitr jupyter))
               (with-current-buffer (awc-gui-source key)
                 (should (eq (quarto-request-state (car (last quarto-runtime--results))) 'succeeded))))
             (awc-gui-log "PASS graphical interruption and recovery preserve both runtimes")
             (switch-to-buffer (awc-gui-source 'preview)) (quarto-preview-document)
             (awc-gui-phase 'preview)))
          ('preview
           (with-current-buffer (awc-gui-source 'preview)
             (when (buffer-live-p quarto-preview--browser)
               (awc-gui-dom-check quarto-preview--browser "document.readyState === 'complete' && document.body.innerText.includes('GUI_PREVIEW_READY')")
               (when (eq awc-gui-dom t)
                 (awc-gui-screenshot "webkit-preview")
                 (awc-gui-log "PASS real WebKit DOM, knitr plot/results and Jupyter kernel")
                 (setq awc-gui-dom nil)
                 (switch-to-buffer (awc-gui-source 'knitr))
                 (setq awc-gui-plot-process (awc-r-run))
                 (awc-gui-phase 'plot-start)))))
          ('plot-start
           (unless (or (process-get awc-gui-plot-process 'busy) (process-get awc-gui-plot-process 'running-async?))
             (with-current-buffer (awc-gui-source 'knitr) (awc/r-httpgd-init-and-open))
             (awc-gui-phase 'plot-browser)))
          ('plot-browser
           (when (buffer-live-p (process-get awc-gui-plot-process 'awc-httpgd-browser))
             (ess-send-string awc-gui-plot-process "plot(1:5, (1:5)^2, col='firebrick', main='Disposable httpgd plot')")
             (awc-gui-phase 'plot-ready)))
          ('plot-ready
           (let ((browser (process-get awc-gui-plot-process 'awc-httpgd-browser)))
             (awc-gui-dom-check browser "document.readyState === 'complete' && (document.querySelector('svg') !== null || [...document.images].some(img => img.naturalWidth > 0))")
             (when (eq awc-gui-dom t)
               (awc-gui-screenshot "httpgd-viewer")
               (awc-gui-log "PASS httpgd device and loaded graphical viewer")
               (setq awc-gui-dom nil)
               (switch-to-buffer (awc-gui-source 'alpha))
               (goto-char (point-max))
               (let ((start (float-time)))
                 (insert (mapconcat (lambda (index) (format "\n## Section %d\nResearch prose λ.\n```{python}\n#| eval: false\nvalue_%d = %d\n```\n" index index index))
                                    (number-sequence 1 250) ""))
                 (quarto-document-model) (quarto-document-projection "python")
                 (awc-gui-log "Substantial document: %d characters, index/projection %.3fs" (buffer-size) (- (float-time) start)))
               (setq awc-gui-soak-start (float-time) awc-gui-last-beat (float-time))
               (awc-gui-resources "warm-up")
               (awc-gui-phase 'soak))))
          ('soak
           (cond
            ((>= (- (float-time) awc-gui-soak-start) awc-gui-seconds)
             (setq awc-gui-soak-end (float-time))
             (should (>= awc-gui-cycles (floor awc-gui-seconds awc-gui-interval)))
             (should (< awc-gui-max-gap 5))
             (awc-gui-screenshot "soak-complete")
             (awc-gui-cleanup) (awc-gui-phase 'cleanup))
            ((>= (- (float-time) awc-gui-soak-start) (* awc-gui-cycles awc-gui-interval))
             (cl-incf awc-gui-cycles)
             (switch-to-buffer (awc-gui-source (if (zerop (% awc-gui-cycles 2)) 'alpha 'beta)))
             (goto-char (point-max))
             (let ((start (float-time)))
               (insert (format "\nEditing cycle %d.\n" awc-gui-cycles))
               (quarto-document-model) (quarto-document-projection "python")
               (should (< (- (float-time) start) 1))
               (awc-gui-log "Cycle %d: edit/index %.3fs" awc-gui-cycles (- (float-time) start)))
             (dolist (key '(knitr jupyter))
               (with-current-buffer (awc-gui-source key)
                 (when (zerop (% awc-gui-cycles 3)) (quarto-restart))
                 (quarto-run-all)))
             (awc-gui-phase 'cycle))))
          ('cycle
           (when (and (awc-gui-ready 'knitr) (awc-gui-ready 'jupyter))
             (setq awc-gui-settle-start (float-time))
             (awc-gui-phase 'settle)))
          ('settle
           ;; Runtime completion precedes background lint/LSP responses and
           ;; the bridge's 4s shutdown fallback. Compare settled resources,
           ;; not a timing-dependent count of these legitimate one-shot timers.
           (when (and (> (- (float-time) awc-gui-settle-start) 6)
                      (zerop (hash-table-count quarto-yaml--pending))
                      (zerop (hash-table-count quarto-yaml--timeouts)))
             (let ((record (awc-gui-resources (format "cycle-%d" awc-gui-cycles))))
               (if (< awc-gui-cycles 3) (setq awc-gui-initial-resources record)
                 (should (<= (plist-get record :buffers) (+ (plist-get awc-gui-initial-resources :buffers) 2)))
                 (should (<= (length (plist-get record :processes)) (+ (length (plist-get awc-gui-initial-resources :processes)) 2)))
                 (should (<= (plist-get record :timers) (+ (plist-get awc-gui-initial-resources :timers) 2)))
                 (should (<= (plist-get record :idle_timers) (+ (plist-get awc-gui-initial-resources :idle_timers) 2)))))
             (awc-gui-phase 'soak)))
          ('cleanup
           (when (and (> (- (float-time) awc-gui-phase-start) 6)
                      (not (cl-some #'process-live-p (delq server-process (process-list)))))
             (dolist (url awc-gui-preview-urls) (should-not (awc-gui-listening-p url)))
             (dolist (directory awc-gui-result-directories) (should-not (file-exists-p directory)))
             (should (zerop (hash-table-count quarto-yaml--pending)))
             (should (zerop (hash-table-count quarto-yaml--timeouts)))
             (should-not awc-gui-warnings)
             (should-not (with-current-buffer "*Messages*" (string-match-p "eldoc error:" (buffer-string))))
             (awc-gui-resources "closed")
             (awc-gui-finish))))
        (unless awc-gui-finished (run-at-time 0.2 nil #'awc-gui-tick)))
    (error (awc-gui-finish (format "%s: %s" awc-gui-phase (error-message-string err))))))

(setq awc-gui-heartbeat (run-at-time 1 1 #'awc-gui-beat))
(run-at-time 2 nil #'awc-gui-tick)
