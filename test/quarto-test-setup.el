;;; quarto-test-setup.el --- Installed packages for isolated checks -*- lexical-binding: t; -*-
(defvar quarto-test-root (file-name-directory (directory-file-name (file-name-directory load-file-name))))
(dolist (directory (directory-files (expand-file-name "straight/build" quarto-test-root) t "^[^.]"))
  (when (file-directory-p directory) (add-to-list 'load-path directory)))
(add-to-list 'load-path (expand-file-name "site-elisp" quarto-test-root))
(add-to-list 'load-path (expand-file-name "test" quarto-test-root))
(require 'ess-site)
(load "lsp-mode-autoloads" nil t)
(require 'quarto-mode)
(require 'ert)
(setq lsp-session-file (expand-file-name "quarto-source-lsp-session" (or (getenv "QUARTO_TEST_RUN_DIR") "/tmp"))
      lsp-restart 'ignore)
(defun quarto-test-wait (predicate description &optional seconds)
  (let ((deadline (+ (float-time) (or seconds 40))))
    (while (and (not (funcall predicate)) (< (float-time) deadline)) (accept-process-output nil 0.05))
    (unless (funcall predicate) (error "Timed out: %s" description))))
(provide 'quarto-test-setup)
