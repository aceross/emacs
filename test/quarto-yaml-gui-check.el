;;; quarto-yaml-gui-check.el --- Actual YAML menus and hints -*- lexical-binding: t; -*-
;; A separate graphical Emacs; this never connects to the user's usual server.
(setq straight-safe-mode t quarto-lsp-auto-start nil)
(require 'server)
(setq server-name "quarto-yaml-gui" server-socket-dir "/tmp/quarto-yaml-gui/server")
(load (expand-file-name "../init.el" (file-name-directory load-file-name)) nil t)
(server-start)
(require 'ert)
(defvar quarto-yaml-gui-source nil)
(defvar quarto-yaml-gui-directory (make-temp-file "/tmp/quarto-yaml-document-" t))
(defvar quarto-yaml-gui-window nil)
(defvar quarto-yaml-gui-step 0)
(defvar quarto-yaml-gui-start (float-time))
(defvar quarto-yaml-gui-log "/tmp/quarto-yaml-gui/result.log")
(make-directory "/tmp/quarto-yaml-gui" t)
(with-temp-file quarto-yaml-gui-log (insert ""))
(defun quarto-yaml-gui-log (format-string &rest args)
  (write-region (concat (apply #'format format-string args) "\n") nil quarto-yaml-gui-log t 'silent))
(defun quarto-yaml-gui-screenshot (name)
  (redisplay t)
  (let ((coding-system-for-write 'no-conversion))
    (write-region (x-export-frames nil 'png) nil (concat "/tmp/quarto-yaml-gui/" name ".png") nil 'silent)
    ;; Native child frames are separate surfaces; the source export omits them.
    (dolist (surface (list (cons "menu" corfu--frame) (cons "hint" corfu-popupinfo--frame)))
      (when (and (frame-live-p (cdr surface)) (frame-visible-p (cdr surface)))
        (write-region (x-export-frames (list (cdr surface)) 'png) nil
                      (concat "/tmp/quarto-yaml-gui/" name "-" (car surface) ".png") nil 'silent)))))
(defun quarto-yaml-gui-fixture (text)
  (when completion-in-region-mode (corfu-quit))
  (switch-to-buffer quarto-yaml-gui-source)
  (widen) (erase-buffer) (insert text)
  (goto-char 1) (search-forward "§") (delete-char -1)
  (quarto-goto-source-position (point))
  (quarto-yaml--post-command))
(defun quarto-yaml-gui-has (candidate)
  (and (bound-and-true-p completion-in-region-mode)
       (frame-live-p corfu--frame) (frame-visible-p corfu--frame) (member candidate corfu--candidates)))
(defun quarto-yaml-gui-accept (candidate)
  (corfu--goto (cl-position candidate corfu--candidates :test #'equal))
  (corfu-insert))
(defun quarto-yaml-gui-type (text)
  ;; Feed the real command loop. Running a keyboard macro inside a timer can
  ;; restore the old current buffer after polymode changes the visible buffer.
  (setq unread-command-events (append (listify-key-sequence text) unread-command-events)))
(defun quarto-yaml-gui-tick ()
  (condition-case error
      (progn
        (when (> (- (float-time) quarto-yaml-gui-start) 60) (error "GUI test deadline"))
        (set-buffer (window-buffer (selected-window)))
        (pcase quarto-yaml-gui-step
          (0
           ;; Visit a genuinely new file, including find-file/local-variable
           ;; hooks.  Creating a mode buffer directly misses startup failures.
           (find-file (expand-file-name "draft.qmd" quarto-yaml-gui-directory))
           (setq quarto-yaml-gui-source (quarto-source-buffer) quarto-yaml-gui-window (selected-window))
           (quarto-yaml-gui-type "---\nti")
           (setq quarto-yaml-gui-step 1))
          (1
           (when (quarto-yaml-gui-has "title: ")
             (should (= corfu-auto-prefix 2)) (should (= corfu-auto-delay 0.25))
             (should (eq (selected-window) quarto-yaml-gui-window))
             (corfu--goto (cl-position "title: " corfu--candidates :test #'equal))
             (corfu--exhibit)
             (quarto-yaml-gui-log "PASS automatic menu in a new, unsaved file after typing its header and two characters")
             (setq quarto-yaml-gui-step 2)))
          (2
           (when (corfu-popupinfo--visible-p)
             (should (string-match-p "Document title" (with-current-buffer " *Quarto YAML documentation*" (buffer-string))))
             (quarto-yaml-gui-screenshot "completion-and-hint")
             (quarto-yaml-gui-log "PASS nearby documentation popup and source focus")
             (quarto-yaml-gui-accept "title: ")
             (should (equal "---\ntitle: " (buffer-string)))
             (quarto-yaml-gui-fixture "---\nformat: h§")
             (quarto-yaml-gui-type "t")
             (setq quarto-yaml-gui-step 3)))
          (3
           (when (quarto-yaml-gui-has "html")
             (quarto-yaml-gui-accept "html")
             (should (equal (buffer-string) "---\nformat: html"))
             (quarto-yaml-gui-log "PASS incomplete front matter remains unchanged except accepted value")
             (quarto-yaml-gui-fixture "> - ~~~~{r}\n>   #| fig-§width: 7\n>   x <- 1\n>   ~~~~\nProse\n")
             (should (derived-mode-p 'ess-r-mode))
             (quarto-yaml-gui-type "wi")
             (setq quarto-yaml-gui-step 4)))
          (4
           (when (quarto-yaml-gui-has "fig-width")
             (quarto-yaml-gui-screenshot "chunk-option")
             (quarto-yaml-gui-accept "fig-width")
             (save-restriction
               (widen)
               (should (string-match-p "#| fig-width: 7" (buffer-string)))
               (goto-char 1) (search-forward "x <- 1"))
             (quarto-yaml--post-command)
             (should (= corfu-auto-prefix 3))
             (should-not completion-in-region-mode)
             (quarto-yaml-gui-log "PASS chunk replacement preserves container, colon and value; code settings restored")
             (quarto-yaml-gui-fixture "---\nformat: §\n---\nProse\n")
             (let ((this-command 'completion-at-point)) (call-interactively #'completion-at-point))
             (setq quarto-yaml-gui-step 5)))
          (5
           (when (quarto-yaml-gui-has "html")
             (quarto-yaml-gui-log "PASS manual completion with an empty value prefix")
             (quarto-yaml-gui-accept "html")
             (quarto-yaml-gui-fixture "---\nfo§\n---\n")
             (quarto-yaml-gui-type "r")
             (setq quarto-yaml-gui-step 6)))
          (6
           (when (quarto-yaml-gui-has "format: ")
             (quarto-yaml-gui-accept "format: ")
             (setq quarto-yaml-gui-step 7)))
          (7
           (when (quarto-yaml-gui-has "html")
             (should (equal (buffer-string) "---\nformat: \n---\n"))
             (quarto-yaml-gui-log "PASS accepting a key offers its schema values without inserting one")
             (quarto-yaml-gui-accept "html")
             (switch-to-buffer (generate-new-buffer "_quarto.yml"))
             (setq buffer-file-name "/tmp/quarto-yaml-gui/_quarto.yml")
             (set-auto-mode)
             (should (memq #'quarto-yaml-completion-at-point completion-at-point-functions))
             (insert "project:\n  ")
             (quarto-yaml-gui-type "ty")
             (setq quarto-yaml-gui-step 8)))
          (8
           (when (quarto-yaml-gui-has "type: ")
             (quarto-yaml-gui-screenshot "project-options")
             (quarto-yaml-gui-log "PASS project YAML automatic menu")
             (corfu-quit)
             (quarto-yaml-gui-fixture "---\nti§\n---\nProse\n")
             (let ((original (symbol-function 'quarto-yaml-request)))
               (cl-letf (((symbol-function 'quarto-yaml-request)
                          (lambda (method payload callback)
                            (funcall original method payload
                                     (lambda (value error) (run-at-time 0.4 nil callback value error))))))
                 (let ((this-command 'completion-at-point)) (quarto-yaml-completion-at-point))))
             (search-forward "Prose") (quarto-yaml--post-command)
             (setq quarto-yaml-gui-step 9)))
          (9
           (unless quarto-yaml--completion-request
             (should-not completion-in-region-mode)
             (should-not (corfu-popupinfo--visible-p))
             (quarto-yaml-gui-log "PASS delayed response cannot reopen a menu in prose")
             (quarto-yaml-gui-log "GUI CHECK COMPLETE")
             (setq quarto-yaml-gui-step 10)
             (dolist (buffer (buffer-list)) (with-current-buffer buffer (set-buffer-modified-p nil)))
             (run-at-time 0.5 nil #'kill-emacs))))
        (when (< quarto-yaml-gui-step 10) (run-at-time 0.1 nil #'quarto-yaml-gui-tick)))
    (error
     (quarto-yaml-gui-log "FAIL step %d: %s" quarto-yaml-gui-step (error-message-string error))
     (quarto-yaml-gui-screenshot "failure"))))
(run-at-time 1 nil #'quarto-yaml-gui-tick)
