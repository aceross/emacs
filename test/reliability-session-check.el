;;; reliability-session-check.el --- Bounded real two-project session -*- lexical-binding: t; -*-
(load (expand-file-name "quarto-test-setup.el" (file-name-directory load-file-name)) nil t)
(require 'awc-python)
(require 'url)
(setq quarto-lsp-auto-start nil)
(defvar awc-session-root (getenv "AWC_RELIABILITY_ROOT"))
(unless (and awc-session-root (file-in-directory-p awc-session-root "/tmp/"))
  (error "Session fixtures must be under /tmp"))
(defvar awc-session-buffers nil)
(defvar awc-session-processes nil)
(defvar awc-session-snapshots nil)
(defun awc-session-open (root name text)
  (let ((file (expand-file-name name root)))
    (with-temp-file file (insert text))
    (let ((buffer (find-file-noselect file)))
      (push buffer awc-session-buffers) buffer)))
(defun awc-session-track (process)
  (set-process-query-on-exit-flag process nil)
  (push process awc-session-processes)
  (when (process-buffer process) (push (process-buffer process) awc-session-buffers))
  process)
(defun awc-session-r-query (process code)
  (with-temp-buffer
    (ess-command (concat code "\n") (current-buffer) nil nil nil process)
    (buffer-string)))
(defun awc-session-ready ()
  (quarto-test-wait (lambda ()
                     (when (eq quarto-runtime--state 'failed)
                       (error "Runtime failed: %s"
                              (with-current-buffer (get-buffer-create (format "*Quarto runtime log: %s*" (buffer-name)))
                                (buffer-string))))
                     (and (eq quarto-runtime--state 'ready)
                          (not quarto-runtime--current) (not quarto-runtime--queue)))
                    "document runtime ready"))
(defun awc-session-http (url marker)
  (let ((buffer (url-retrieve-synchronously url t nil 10)))
    (unwind-protect
        (with-current-buffer (or buffer (error "No preview response: %s" url))
          (should (eq url-http-response-status 200))
          (goto-char (point-min))
          (should (search-forward marker nil t)))
      (when (buffer-live-p buffer) (kill-buffer buffer)))))
(defun awc-session-preview-ready ()
  (quarto-test-wait
   (lambda ()
     (when (and quarto-preview--process (not (process-live-p quarto-preview--process)))
       (error "Preview failed: %s" (with-current-buffer (process-buffer quarto-preview--process) (buffer-string))))
     quarto-preview--url)
   "live preview URL" 60))
(defun awc-session-url-listening-p (url)
  "Check the actual server socket, not only Emacs's parent process object."
  (let ((parsed (url-generic-parse-url url)) process)
    (unwind-protect
        (condition-case nil
            (progn
              (setq process (open-network-stream "preview-stop-probe" nil
                                                 (url-host parsed) (url-port parsed)))
              (process-live-p process))
          (file-error nil))
      (when (processp process) (delete-process process)))))
(defun awc-session-resource-snapshot (cycle)
  (quarto-test-wait (lambda () (and (zerop (hash-table-count quarto-yaml--pending))
                                   (zerop (hash-table-count quarto-yaml--timeouts))))
                    "shared schema requests settle")
  ;; Allow document artefact cleanup (5s), one-shot UI timers and sentinels.
  (let ((until (+ (float-time) 5.5)))
    (while (< (float-time) until) (accept-process-output nil 0.1)))
  (let ((snapshot (list :cycle cycle
                        :processes (mapcar #'process-name (cl-remove-if-not #'process-live-p (process-list)))
                        :buffers (mapcar #'buffer-name (buffer-list))
                        :timers (length timer-list) :idle_timers (length timer-idle-list)
                        :r_session_keys (hash-table-count awc-r--sessions))))
    (push snapshot awc-session-snapshots)
    (princ (format "RESOURCES %S\n" snapshot))
    ;; Logs and the shared schema helper may persist; warm-up establishes
    ;; their bound. REPL transcripts are closed explicitly by this fixture.
    (when-let* ((previous (cadr awc-session-snapshots)))
      (dolist (key '(:processes :buffers))
        (should-not (cl-set-difference (plist-get snapshot key) (plist-get previous key) :test #'equal)))
      (should (<= (plist-get snapshot :timers) (plist-get previous :timers)))
      (should (<= (plist-get snapshot :idle_timers) (plist-get previous :idle_timers))))
    (should (<= (hash-table-count awc-r--sessions) 2))))

(unwind-protect
    (dotimes (cycle (string-to-number (or (getenv "AWC_RELIABILITY_CYCLES") "3")))
      (let (py-sources r-sources runtimes previews python-processes r-processes directories)
        (dolist (label '("project alpha" "project β"))
          (let* ((root (file-name-as-directory (expand-file-name label awc-session-root)))
                 (python (expand-file-name ".venv/bin/python" root))
                 (py (awc-session-open root "analysis.py" "value = 1\n"))
                 (r (awc-session-open root "analysis.R" "value <- 1\n"))
                 (doc (awc-session-open
                       root "reports/nested space/runtime.qmd"
                       "---\nengine: knitr\n---\n```{r}\ncat(getOption('awc.fixture'), '\\n')\n```\n```{r}\n#| eval: false\ncat('SLEEPSTART\\n'); Sys.sleep(20)\n```\n"))
                 (preview (awc-session-open root "reports/nested space/preview.qmd"
                                            (format "---\ntitle: Lifecycle\nformat: html\n---\nPreview %s\n" label))))
            (push py py-sources) (push r r-sources) (push doc runtimes) (push preview previews)
            (with-current-buffer py
              (let ((process (awc-session-track (awc-python-run))))
                (push process python-processes)
                (should (equal (string-trim (python-shell-send-string-no-output "import sys; print(sys.prefix)" process))
                               (directory-file-name (expand-file-name ".venv" root))))))
            (with-current-buffer r
              (let ((process (awc-session-track (awc-r-run))))
                (push process r-processes)
                (should (string-match-p (regexp-quote label)
                                        (awc-session-r-query process "cat(getOption('awc.fixture'), '\\n')")))))
            (with-current-buffer doc
              (quarto-run-all) (awc-session-ready)
              (should (eq (quarto-request-state (car quarto-runtime--results)) 'succeeded))
              (should (equal (quarto-get quarto-runtime--identity "startup_directory") (directory-file-name root)))
              (should (equal (quarto-get quarto-runtime--identity "python") python))
              (push quarto-runtime--directory directories))))
        ;; Reverse project order consistently: alpha first, beta second.
        (setq py-sources (nreverse py-sources) r-sources (nreverse r-sources)
              runtimes (nreverse runtimes) previews (nreverse previews)
              python-processes (nreverse python-processes) r-processes (nreverse r-processes))
        (should-not (eq (car python-processes) (cadr python-processes)))
        (should-not (eq (car r-processes) (cadr r-processes)))
        ;; Interrupt and restart alpha while beta retains its state/process.
        (with-current-buffer (car py-sources)
          (python-shell-send-string "import time; time.sleep(20)" (car python-processes))
          (accept-process-output (car python-processes) 0.2)
          (awc-python-interrupt)
          (quarto-test-wait
           (lambda () (with-current-buffer (process-buffer (car python-processes))
                        (save-excursion (goto-char (point-min)) (search-forward "KeyboardInterrupt" nil t))))
           "Python interrupt")
          (awc-session-track (awc-python-run t))
          (should-not (process-live-p (car python-processes)))
          ;; Reopening an unexpectedly ended REPL has the same native mode
          ;; reset as explicit restart; it must dispose its helper too.
          (let ((process (awc-python-run)))
            (delete-process process)
            (awc-session-track (awc-python-run))))
        (with-current-buffer (car r-sources)
          (ess-send-string (car r-processes) "Sys.sleep(20)")
          (accept-process-output (car r-processes) 0.2)
          (awc-r-interrupt)
          (ess-wait-for-process (car r-processes))
          (awc-session-track (awc-r-run t))
          (should-not (process-live-p (car r-processes))))
        (with-current-buffer (cadr py-sources)
          (should (eq (awc-python-run) (cadr python-processes)))
          (should (equal (string-trim (python-shell-send-string-no-output "print(6 * 7)" (cadr python-processes))) "42")))
        (with-current-buffer (cadr r-sources)
          (should (eq (awc-r-process) (cadr r-processes)))
          (should (string-match-p "42" (awc-session-r-query (cadr r-processes) "cat(6 * 7, '\\n')"))))
        (with-current-buffer (car runtimes)
          (goto-char (point-min)) (search-forward "Sys.sleep")
          (quarto-run-chunk)
          (quarto-test-wait
           (lambda () (cl-some (lambda (event) (string-match-p "SLEEPSTART" (quarto-get event "text" "")))
                              (quarto-request-events (cadr quarto-runtime--results)))) "R chunk starts sleeping")
          (quarto-interrupt) (awc-session-ready)
          (should (eq (quarto-request-state (cadr quarto-runtime--results)) 'interrupted))
          ;; Cancellation immediately after dispatch must also survive the
          ;; interval before the R evaluator enters its interrupt handler.
          (dotimes (_ 3)
            (quarto-run-chunk) (quarto-interrupt) (awc-session-ready))
          (let ((process quarto-runtime--process))
            (quarto-interrupt) ; idle cancellation must leave the next run usable
            (quarto-run-all) (awc-session-ready)
            (should (eq process quarto-runtime--process)))
          (let ((old quarto-runtime--process))
            (quarto-restart) (quarto-run-all) (awc-session-ready)
            (should-not (process-live-p old)))
          ;; An unexpected runtime exit is visible and the next run recovers.
          (delete-process quarto-runtime--process)
          (should (eq quarto-runtime--state 'failed))
          (quarto-run-all) (awc-session-ready))
        (with-current-buffer (cadr runtimes)
          (should (process-live-p quarto-runtime--process))
          (quarto-run-all) (awc-session-ready))
        ;; Only replace browser presentation; use actual servers and HTTP.
        (cl-letf (((symbol-function 'quarto-preview--show) #'ignore))
          (dolist (source previews)
            (with-current-buffer source
              (quarto-preview-document)
              (awc-session-preview-ready)
              (awc-session-http quarto-preview--url "Lifecycle")))
          (with-current-buffer (car previews)
            (let ((old quarto-preview--process) (url quarto-preview--url))
              (quarto-stop-preview) (quarto-stop-preview)
              (should-not (process-live-p old))
              (quarto-test-wait (lambda () (not (awc-session-url-listening-p url)))
                                "stopped preview releases its socket" 5)
              (quarto-preview-document)
              (awc-session-preview-ready)))
          (with-current-buffer (cadr previews)
            (should (process-live-p quarto-preview--process))
            (awc-session-http quarto-preview--url "Lifecycle")))
        ;; Closing sources owns document runtimes/previews, but intentionally
        ;; leaves project REPLs available to other source buffers.
        (let ((owned (mapcar (lambda (buffer) (buffer-local-value 'quarto-runtime--process buffer)) runtimes))
              (servers (mapcar (lambda (buffer) (buffer-local-value 'quarto-preview--process buffer)) previews))
              (urls (mapcar (lambda (buffer) (buffer-local-value 'quarto-preview--url buffer)) previews)))
          (dolist (buffer (append py-sources r-sources runtimes previews)) (kill-buffer buffer))
          (dolist (process (append owned servers)) (should-not (process-live-p process)))
          (dolist (url urls)
            (quarto-test-wait (lambda () (not (awc-session-url-listening-p url)))
                              "closed preview releases its socket" 5)))
        (should (process-live-p (cadr python-processes)))
        (should (process-live-p (cadr r-processes)))
        ;; Explicitly end the REPL sessions and close retained transcripts.
        (dolist (process awc-session-processes)
          (when (process-live-p process) (delete-process process)))
        (dolist (buffer awc-session-buffers)
          (when (buffer-live-p buffer)
            (with-current-buffer buffer (set-buffer-modified-p nil)) (kill-buffer buffer)))
        (setq awc-session-buffers nil awc-session-processes nil)
        (awc-session-resource-snapshot (1+ cycle))
        (dolist (directory directories) (should-not (file-exists-p directory)))
        (princ (format "PASS cycle %d: isolated Python/R REPLs, R document runtimes, HTTP previews, interruption/restart/exit/close\n" (1+ cycle)))))
  (dolist (buffer awc-session-buffers)
    (when (buffer-live-p buffer) (with-current-buffer buffer (set-buffer-modified-p nil)) (kill-buffer buffer)))
  (dolist (process awc-session-processes)
    (when (process-live-p process) (delete-process process)))
  (when (process-live-p quarto-yaml--process) (delete-process quarto-yaml--process)))
(princ "PASS bounded two-project lifecycle; logs/schema helper stay bounded after warm-up\n")
