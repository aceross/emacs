;;; awc-research-quarto-integration.el --- Reference to note to rendered citation -*- lexical-binding: t; -*-
(load (expand-file-name "quarto-test-setup.el" (file-name-directory load-file-name)) nil t)
(require 'awc-research-test)
(setq quarto-lsp-auto-start nil)

(ert-deftest awc-research-quarto-complete-fixture-workflow ()
  (awc-research-test--fixture
    (let* ((key (awc-research-import-item "ABC12345"))
           (note (awc-research-open-note key))
           (note-file (buffer-file-name note))
           (note-text (awc-research-test--read note-file))
           (file (expand-file-name "paper.qmd" root))
           (default-directory root))
      (with-temp-file (expand-file-name "_quarto.yml" root)
        (insert "project:\n  type: default\n"))
      (with-temp-file file
        (insert "---\ntitle: Literature workflow check\nengine: markdown\nformat: html\nbibliography: data/zotero.bib\n---\n\nA source "))
      (with-current-buffer (find-file-noselect file)
        (quarto-test-wait (lambda () (member key quarto-authoring--citations))
                          "imported reference in Quarto")
        (goto-char (point-max))
        (let ((citar-markdown-prompt-for-extra-arguments nil))
          (citar-insert-citation (list key)))
        (insert ".\n")
        (save-buffer)
        (goto-char (point-min))
        (search-forward (concat "@" key))
        (let ((capf (quarto-reference-completion-at-point)))
          (should (member key (nth 2 capf)))
          (should (string-match-p "Person.*2024.*A source"
                                  (funcall (plist-get (nthcdr 3 capf) :annotation-function) key))))
        (should (equal citar-bibliography (list (awc-research--bibliography)))))
      (with-temp-buffer
        (let ((status (call-process "quarto" nil t nil "render" file "--to" "html")))
          (unless (eq status 0) (ert-fail (buffer-string)))))
      (let ((html (awc-research-test--read (expand-file-name "paper.html" root))))
        (should (string-match-p "data-cites=\"saved24:key\"" html))
        (should (string-match-p "id=\"ref-saved24:key\"" html))
        (should-not (string-match-p "<<CITATION>>" html)))
      (should (equal key (awc-research-import-item "ABC12345")))
      (should (eq note (awc-research-open-note key)))
      (should (equal note-text (awc-research-test--read note-file))))))

(ert-run-tests-batch-and-exit "awc-research-quarto-complete")
