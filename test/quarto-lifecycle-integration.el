;;; quarto-lifecycle-integration.el --- Queue, failure and cleanup checks -*- lexical-binding: t; -*-
(load (expand-file-name "quarto-test-setup.el" (file-name-directory load-file-name)) nil t)
(setq quarto-lsp-auto-start nil)
(defvar quarto-lifecycle-sources nil)
(defun quarto-lifecycle-open (name text)
  (let ((file (expand-file-name (concat name ".qmd") "/tmp/quarto-runtime-check/project with spaces/reports/nested space/")))
    (with-temp-file file (insert text))
    (let ((source (find-file-noselect file))) (push source quarto-lifecycle-sources) source)))
(unwind-protect
    (let ((source (quarto-lifecycle-open "queue-check" "---\nengine: knitr\n---\n```{r}\nx <- 1\nstop('stop here')\n```\n```{r}\nx <- 999\n```\n")))
      (with-current-buffer source
        (quarto-run-all)
        (quarto-test-wait (lambda () (and (eq quarto-runtime--state 'ready) (null quarto-runtime--queue) (null quarto-runtime--current))) "stop on error")
        (should (equal (mapcar #'quarto-request-state quarto-runtime--results) '(failed interrupted)))
        (should-not (quarto-request-events (cadr quarto-runtime--results)))
        (let ((process quarto-runtime--process) (directory quarto-runtime--directory))
          (kill-buffer source)
          (should-not (process-live-p process))
          (quarto-test-wait (lambda () (not (file-exists-p directory))) "temporary result cleanup" 8)))
      (princ "PASS bulk stops on error; close stops runtime and removes owned artefacts\n")
      (with-current-buffer (quarto-lifecycle-open "missing-kernel" "---\njupyter: nonexistent-quarto-validation-kernel\n---\n```{python}\nprint('must not run')\n```\n")
        (quarto-run-all)
        (quarto-test-wait (lambda () (eq (quarto-request-state (car quarto-runtime--results)) 'failed)) "missing kernel failure")
        (should-not quarto-runtime--identity)
        (should-not (cl-some (lambda (event) (equal (quarto-get event "text") "must not run"))
                            (quarto-request-events (car quarto-runtime--results))))
        (princ "PASS missing named kernel fails without substitution\n")))
  (dolist (source quarto-lifecycle-sources)
    (when (buffer-live-p source) (with-current-buffer source (set-buffer-modified-p nil)) (kill-buffer source))))
