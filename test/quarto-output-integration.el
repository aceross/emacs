;;; quarto-output-integration.el --- Real nested-directory render and preview -*- lexical-binding: t; -*-
(load (expand-file-name "quarto-test-setup.el" (file-name-directory load-file-name)) nil t)
(setq quarto-lsp-auto-start nil)
(defvar quarto-output-root "/tmp/quarto-runtime-check/project with spaces/")
(defvar quarto-output-source nil)
(defvar quarto-output-preview nil)
(defvar quarto-output-pdf nil)
(defun quarto-output-wait-render ()
  (quarto-test-wait (lambda () quarto-render--process) "render launch")
  (quarto-test-wait (lambda () (not (process-live-p quarto-render--process))) "render completion" 60)
  (unless (= 0 (process-exit-status quarto-render--process))
    (error "Render failed: %s" (with-current-buffer (process-buffer quarto-render--process) (buffer-string)))))
(unwind-protect
    (let* ((file (expand-file-name "reports/nested space/output report.qmd" quarto-output-root)))
      (with-temp-file file
        (insert "---\ntitle: Output validation\nengine: knitr\nformat:\n  html: default\n  pdf:\n    pdf-engine: pdflatex\n---\n# Result {#sec-result}\n\n```{r}\nx <- 21\n```\n\n```{python}\nprint(r.x * 2)\n```\n"))
      (setq quarto-output-source (find-file-noselect file))
      (with-current-buffer quarto-output-source
        (quarto-select-format "html")
        (quarto-build-document) (quarto-output-wait-render)
        (should (equal (file-name-extension quarto-render--output) "html"))
        (should (file-readable-p quarto-render--output))
        (setq quarto-render--process nil)
        (quarto-select-format "pdf")
        (cl-letf (((symbol-function 'quarto-render--open-pdf) (lambda (path) (setq quarto-output-pdf path))))
          (quarto-build-document) (quarto-output-wait-render))
        (should (file-readable-p quarto-output-pdf))
        (princ "PASS mixed knitr HTML/PDF rendering from nested directories with spaces\n")
        (cl-letf (((symbol-function 'quarto-preview--show)
                   (lambda (source) (setq quarto-output-preview (buffer-local-value 'quarto-preview--url source)))))
          (quarto-preview-document)
          (quarto-test-wait (lambda () quarto-output-preview) "HTML preview URL" 60)
          (require 'url)
          (let ((response (url-retrieve-synchronously quarto-output-preview t nil 10)))
            (should (buffer-live-p response))
            (with-current-buffer response (should (equal url-http-response-status 200)))
            (kill-buffer response))
          (princ "PASS live HTML preview while PDF is selected\n"))))
  (when (buffer-live-p quarto-output-source)
    (when-let* ((process (buffer-local-value 'quarto-preview--process quarto-output-source)))
      (with-current-buffer (process-buffer process)
        (write-region (point-min) (point-max) "/tmp/quarto-preview-test.log" nil 'silent)))
    (with-current-buffer quarto-output-source (quarto-stop-preview) (quarto-stop-render) (set-buffer-modified-p nil))
    (kill-buffer quarto-output-source)))
