;;; awc-bibliography-quarto-integration.el --- Portable project snapshot QA -*- lexical-binding: t; -*-
(load (expand-file-name "quarto-test-setup.el" (file-name-directory load-file-name)) nil t)
(require 'awc-bibliography-test)
(setq quarto-lsp-auto-start nil)

(ert-deftest awc-bibliography-quarto-reviewed-snapshot-renders-after-moving ()
  (awc-research-test--fixture
   (let* ((project (expand-file-name "manuscript alpha/" root))
          (copy (expand-file-name "different device/project beta/" root))
          (paper (expand-file-name "chapters/paper.qmd" project))
          (target (expand-file-name "references.bib" project))
          (key "legacy:key")
          (default-directory project))
     (make-directory (file-name-directory paper) t)
     (with-temp-file primary
       (insert "@article{legacy:key,title={A source},author={Person, Alice},year={2024},doi={10.1/source},file={/other-device/paper.pdf}}\n"))
     (awc-research-import-item "ABC12345" "groups/42")
     (let* ((note (awc-research-open-note key))
            (note-file (buffer-file-name note))
            (note-text (awc-research-test--read note-file))
            (primary-text (awc-research-test--read primary))
            (links-text (awc-research-test--read (awc-research--links-file))))
       (with-temp-file (expand-file-name "_quarto.yml" project)
         (insert "project:\n  type: default\nbibliography: references.bib\n"))
       (with-temp-file target (insert "% Manual manuscript snapshot.\n"))
       (with-temp-file paper
         (insert "---\ntitle: Portable reference é\nengine: markdown\nformat: html\n---\n\nA source "))
       (let* ((source (find-file-noselect paper))
              (review
               (save-window-excursion
                 (with-current-buffer source
                   (cl-letf (((symbol-function 'awc-research--get)
                              (lambda (&rest _) (error "Local snapshot add must not contact Zotero")))
                             ((symbol-function 'awc-research--global-key) (lambda () key)))
                     (call-interactively #'awc-bibliography-prepare))))))
         (should (buffer-live-p review))
         (should (equal "% Manual manuscript snapshot.\n" (awc-research-test--read target)))
         (save-window-excursion
           (switch-to-buffer review)
           (execute-kbd-macro (kbd "C-c C-c")))
         (with-current-buffer source
           (should (member key quarto-authoring--citations))
           (should (equal citar-bibliography (list target)))
           (goto-char (point-max))
           (let ((citar-markdown-prompt-for-extra-arguments nil))
             (citar-insert-citation (list key)))
           (insert ".\n")
           (save-buffer))
         (kill-buffer review)
         (setq awc-research-test--api-key "changed-native-key"
               awc-research-test--export "@article{changed-native-key,title={A corrected source é},author={Person, Alice},year={2025},doi={10.1/source},file={/new-device/paper.pdf}}")
         (let ((refresh (save-window-excursion
                          (with-current-buffer source (awc-bibliography-refresh key)))))
           (with-current-buffer refresh (awc-bibliography-apply))
           (kill-buffer refresh))
         (should (string-match-p "@article{legacy:key," (awc-research-test--read target)))
         (should-not (string-match-p "other-device\\|new-device\\|changed-native-key" (awc-research-test--read target)))
         (should (equal primary-text (awc-research-test--read primary)))
         (should (equal links-text (awc-research-test--read (awc-research--links-file))))
         (should (equal note-text (awc-research-test--read note-file)))
         (make-directory (file-name-directory (directory-file-name copy)) t)
         (copy-directory project copy nil nil t)
         (let* ((copied-paper (expand-file-name "chapters/paper.qmd" copy))
                (elsewhere (expand-file-name "unrelated working directory/" root))
                (citar-bibliography nil)
                (citar--entries nil))
           (make-directory elsewhere)
           (cl-letf (((symbol-function 'awc-research--get)
                      (lambda (&rest _) (error "Zotero is unavailable on this device"))))
             (with-current-buffer (find-file-noselect copied-paper)
               (quarto-test-wait (lambda () (member key quarto-authoring--citations)) "copied project bibliography")
               (should (equal citar-bibliography (list (expand-file-name "references.bib" copy)))))
             (dolist (format '("html" "pdf"))
               (let ((default-directory elsewhere)
                     (process-environment (cons (concat "HOME=" (expand-file-name "empty-home/" root)) process-environment)))
                 (with-temp-buffer
                   (let ((status (call-process "quarto" nil t nil "render" copied-paper "--to" format)))
                     (unless (eq status 0) (ert-fail (buffer-string)))))))
             (let ((html (awc-research-test--read (expand-file-name "chapters/paper.html" copy))))
               (should (string-match-p "data-cites=\"legacy:key\"" html))
               (should (string-match-p "id=\"ref-legacy:key\"" html))
               (should (string-match-p "A corrected source" html))
               (should-not (string-match-p "citation not found\\|<<CITATION>>" html)))
             (should (> (file-attribute-size (file-attributes (expand-file-name "chapters/paper.pdf" copy))) 1000)))))))))

(ert-deftest awc-bibliography-quarto-refuses-missing-declaration-and-unsaved-source ()
  (awc-research-test--fixture
   (let* ((file (expand-file-name "paper.qmd" root))
          (target (expand-file-name "references.bib" root)))
     (with-temp-file file (insert "---\nengine: markdown\n---\n\nA manuscript.\n"))
     (with-temp-file target (insert "% No changes.\n"))
     (with-current-buffer (find-file-noselect file)
       (should-error (awc-bibliography-prepare "unknown-key" target) :type 'user-error)
       (goto-char (point-max)) (insert "Unsaved edit.\n")
       (should-error (awc-bibliography-prepare "unknown-key" target) :type 'user-error))
     (should (equal "% No changes.\n" (awc-research-test--read target))))))

(ert-run-tests-batch-and-exit "awc-bibliography-quarto-")
