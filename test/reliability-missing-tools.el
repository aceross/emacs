;;; reliability-missing-tools.el --- Missing optional tools after native startup -*- lexical-binding: t; -*-
(require 'ert)
(defun awc-reliability-user-error (function pattern)
  (let ((error (should-error (funcall function) :type 'user-error)))
    (should (string-match-p pattern (error-message-string error)))))
(dolist (tool '("quarto" "node" "R" "pyright-langserver"))
  (should-not (executable-find tool)))
(let* ((root (expand-file-name "missing-tools/" awc-reliability-root))
       (before (process-list)))
  (make-directory root t)
  (with-temp-file (expand-file-name "fixture.Rproj" root) (insert "Version: 1.0\n"))
  (dolist (entry '(("analysis.py" . "value = 1\n") ("analysis.R" . "value <- 1\n")
                   ("report.qmd" . "---\ntitle: Missing tools\nformat: html\n---\nSome prose.\n")
                   ("note.md" . "# Note\nSome prose.\n")))
    (let ((file (expand-file-name (car entry) root)))
      (with-temp-file file (insert (cdr entry)))
      (with-current-buffer (find-file-noselect file)
        (goto-char (point-max)) (insert "\n") (save-buffer)
        (cond
         ((string-suffix-p ".py" file)
          (should awc-python-environment-error)
          (awc-reliability-user-error #'awc-python-run "No project Python")
          ;; A missing server remains explicit even with a reviewed interpreter.
          (setq-local awc-project-python (expand-file-name "interpreter" root))
          (with-temp-file awc-project-python (insert "#!/bin/sh\nexit 0\n"))
          (set-file-modes awc-project-python #o700)
          (awc-reliability-user-error #'awc-python-start-lsp "pyright-langserver is missing"))
         ((string-suffix-p ".R" file)
          (awc-reliability-user-error #'awc-r-run "Cannot find R"))
         ((string-suffix-p ".qmd" file)
          (should (string-match-p "Quarto executable is missing" quarto-yaml-error))
          (let ((before (buffer-list)))
            (dotimes (_ 3)
              (awc-reliability-user-error #'quarto-preview-document "Cannot find quarto"))
            (should-not (cl-set-difference (buffer-list) before)))
          (let ((quarto-editor-bundle "/explicit/editor/bundle.mjs") response)
            (quarto-yaml-request "parse" '(:code "title: Example")
                                 (lambda (_value error) (setq response error)))
            (should (string-match-p "YAML assistance needs Node" response))))))
      (kill-buffer (get-file-buffer file))))
  (should-not (cl-set-difference (cl-remove-if-not #'process-live-p (process-list)) before)))
(let* ((process-environment (copy-sequence process-environment))
       (path (getenv "AWC_RELIABILITY_ORIGINAL_PATH"))
       (exec-path (append (split-string path path-separator t) (list exec-directory))))
  (setenv "PATH" path)
  ;; Restore tools within this same session and reuse the previously failed
  ;; document. A missing dependency must not poison subsequent requests.
  (with-current-buffer (find-file-noselect (expand-file-name "missing-tools/report.qmd" awc-reliability-root))
    (let (done context failure)
      (quarto-context-resolve (lambda (value error) (setq context value failure error done t)))
      (let ((until (+ (float-time) 20)))
        (while (and (not done) (< (float-time) until)) (accept-process-output nil 0.05)))
      (should done) (should context) (should-not failure))
    (kill-buffer))
  ;; Restrict R's libraries inside a child only. The installed packages and
  ;; project libraries are never renamed, removed or installed by this check.
  (dolist (case (list (list (car (last (awc-r-lsp--command))) "languageserver is unavailable")
                     (list awc-r-httpgd--command "Install httpgd explicitly")))
    (with-temp-buffer
      (call-process (executable-find "Rscript") nil (current-buffer) nil "--vanilla" "-e"
                    (concat ".libPaths(.Library); " (car case)))
      (should (string-match-p (cadr case) (buffer-string)))))
  (when (process-live-p quarto-yaml--process) (delete-process quarto-yaml--process)))
(princ "PASS native startup and Python/R/Quarto/Markdown editing without optional tools; explicit actions explain missing dependencies\n")
(princ "PASS tools restored in the same session; absent R libraries give explicit installation guidance\n")
